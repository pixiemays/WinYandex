<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="YMusic.WinUI.Views.Controls.ArtistCardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    CloseButtonText="Закрыть"
    DefaultButton="None"
    CornerRadius="16"
    BorderThickness="1"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    mc:Ignorable="d">

    <Grid Width="520" MaxHeight="600" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- Header: Avatar, Name, Stats -->
            <RowDefinition Height="Auto" />
            <!-- Content: Tracks and Albums -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Avatar, Name, Stats -->
        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Artist Avatar (circular with PersonPicture) -->
            <PersonPicture x:Name="ArtistPicture"
                           Grid.Column="0"
                           Width="72"
                           Height="72"
                           VerticalAlignment="Center" />

            <!-- Name & Meta -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="ArtistNameTextBlock"
                           FontSize="20"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock x:Name="ArtistListenersTextBlock"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ArtistGenresTextBlock"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Loading State -->
        <StackPanel x:Name="LoadingPanel"
                    Grid.Row="1"
                    Spacing="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="32">
            <ProgressRing IsActive="True" Width="36" Height="36" />
            <TextBlock Text="Загрузка профиля артиста..."
                       FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer x:Name="ContentScrollViewer"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Padding="0,0,8,0">
                <!-- Popular Tracks -->
                <StackPanel x:Name="PopularTracksSection" Spacing="8">
                    <TextBlock Text="Популярные треки"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsRepeater x:Name="TracksRepeater">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,8"
                                        Margin="0,2"
                                        CornerRadius="8"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        Click="TrackRow_Click">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Track Cover / Play Icon -->
                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid>
                                                <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Stretch="UniformToFill" />
                                                <Border Background="#40000000" CornerRadius="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Track Title & Version -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind FullTitle, Mode=OneWay}"
                                                       FontSize="13"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                            <TextBlock Text="{x:Bind ArtistNames, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                        </StackPanel>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>

                <!-- Albums & Singles -->
                <StackPanel x:Name="AlbumsSection" Spacing="8">
                    <TextBlock Text="Альбомы и релизы"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsRepeater x:Name="AlbumsRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="12" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Width="110"
                                            Padding="6"
                                            CornerRadius="8"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Click="AlbumCard_Click">
                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                            <Border Width="98"
                                                    Height="98"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock Text="{x:Bind Year, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
