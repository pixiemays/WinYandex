<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!-- Loading overlay -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="44"
                      Height="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Canvas.ZIndex="10" />

        <!-- Error InfoBar -->
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="Explore Error"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 VerticalAlignment="Top"
                 Margin="32,16"
                 Canvas.ZIndex="20" />

        <!-- 1. MAIN BROWSE VIEW -->
        <ScrollViewer Visibility="{x:Bind ViewModel.IsBrowseVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      Padding="32,24,32,24">
            <StackPanel Spacing="28">
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.LoadExploreDataCommand}"
                            Height="36"
                            ToolTipService.ToolTip="{x:Bind ViewModel.RefreshButtonText, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.RefreshButtonText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- SECTION 1: Personal Playlists ("Собираем для вас" / Плейлист дня, etc.) -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC26;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PersonalPlaylistsTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PersonalPlaylists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Button Click="PersonalPlaylistCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Direct Play Button Overlay -->
                                                    <Button Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="Play now">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Description}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               Height="32" />
                                                    <TextBlock Text="{x:Bind TrackCount, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 2: New Releases (Albums) -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE93C;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NewReleasesTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NewReleases, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Click="AlbumCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE93C;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <Button Click="DirectPlayAlbum_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="Play album">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind ArtistNames}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Year, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 3: Editorial Playlists ("Популярные плейлисты") -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE142;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EditorialPlaylistsTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EditorialPlaylists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Button Click="EditorialPlaylistCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE142;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <Button Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="Play playlist">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind OwnerName}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind TrackCount, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 4: Top Chart ("Чарт") -->
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ChartTracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button Click="ChartTrackRow_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Padding="0"
                                        Margin="0,1">
                                    <Border CornerRadius="8"
                                            Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}">
                                        <Grid Height="50" Padding="8,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Accent Bar -->
                                            <Rectangle Grid.Column="0"
                                                       Width="3"
                                                       Height="16"
                                                       RadiusX="1.5"
                                                       RadiusY="1.5"
                                                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Thumbnail with Equalizer -->
                                            <Border Grid.Column="1"
                                                    Width="38"
                                                    Height="38"
                                                    CornerRadius="4"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                                    <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Background="#A6000000"
                                                          CornerRadius="4">
                                                        <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Artist -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MaxWidth="360" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind FullTitle}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <Border Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="4,1"
                                                            CornerRadius="3"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                            <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind ArtistNames}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Album (Clickable) -->
                                            <HyperlinkButton Grid.Column="3"
                                                             Click="TrackAlbum_Click"
                                                             Tag="{x:Bind}"
                                                             Padding="0"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"
                                                             ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                                <TextBlock Text="{x:Bind AlbumTitle}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </HyperlinkButton>

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind FormattedDuration}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. DETAIL VIEW (when Playlist or Album is clicked) -->
        <Grid Visibility="{x:Bind ViewModel.IsDetailOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              Padding="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0"
                    Command="{x:Bind ViewModel.CloseDetailCommand}"
                    Margin="0,0,0,16"
                    Height="34">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="Back to Explore" />
                </StackPanel>
            </Button>

            <!-- Hero Section -->
            <Grid x:Name="DetailHeroGrid"
                  Grid.Row="1"
                  Margin="0,0,0,24"
                  Background="Transparent"
                  PointerWheelChanged="DetailHeroGrid_PointerWheelChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cover Artwork -->
                <Border x:Name="DetailCoverBorder"
                        Grid.Column="0"
                        Width="180"
                        Height="180"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="DetailCoverIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="36"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.DetailCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Metadata & Action Buttons -->
                <StackPanel x:Name="DetailMetaStack"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="24,0,0,0"
                            Spacing="8">
                    <Border x:Name="DetailBadgeBorder"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Padding="8,3"
                            CornerRadius="4"
                            HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind ViewModel.DetailTypeBadge, Mode=OneWay}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="Black" />
                    </Border>

                    <TextBlock x:Name="DetailTitleText"
                               Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                               FontSize="30"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />

                    <StackPanel x:Name="DetailExtraInfoPanel" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxLines="2"
                                   Visibility="{x:Bind ViewModel.DetailDescription, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                        <TextBlock Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <!-- Play All & Shuffle Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Command="{x:Bind ViewModel.PlayDetailAllCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="Play All" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ShufflePlayDetailCommand}"
                                Height="36">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                <TextBlock Text="Shuffle" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleDetailPinCommand}"
                                Height="36"
                                Padding="14,0"
                                ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                          FontSize="13"
                                          Foreground="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinButtonTextConverter}}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Detail Tracks List -->
            <Grid Grid.Row="2">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingDetail, Mode=OneWay}"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <controls:ObservableListView x:Name="DetailTracksListView"
                                             ItemsSource="{x:Bind ViewModel.DetailTracks, Mode=OneWay}"
                                             IsItemClickEnabled="True"
                                             ItemClick="DetailTrack_ItemClick"
                                             SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="48" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Border CornerRadius="8"
                                    Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                    Margin="0">
                                <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Accent Indicator -->
                                    <Rectangle Grid.Column="0"
                                               Width="3"
                                               Height="18"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Margin="0,0,6,0"
                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Thumbnail with Animated Equalizer -->
                                    <Border Grid.Column="1"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8D6;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                            <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Background="#A6000000"
                                                  CornerRadius="4">
                                                <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Artist -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="360" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind FullTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                            <Border Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="4,1"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ArtistNames}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Album (Clickable) -->
                                    <HyperlinkButton Grid.Column="3"
                                                     Click="TrackAlbum_Click"
                                                     Tag="{x:Bind}"
                                                     Padding="0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                        <TextBlock Text="{x:Bind AlbumTitle}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind FormattedDuration}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />

                                    <!-- Like Button -->
                                    <Button Grid.Column="5"
                                            Click="DetailLikeButton_Click"
                                            Tag="{x:Bind}"
                                            Width="34"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="17"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                  FontSize="15"
                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </controls:ObservableListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
