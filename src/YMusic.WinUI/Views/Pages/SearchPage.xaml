<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="MainScrollViewer"
                      Padding="32,24,32,32">
            <StackPanel Spacing="24" MaxWidth="1280" HorizontalAlignment="Stretch">

                <!-- 1. Search Header & Large Input Bar -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Search"
                               FontSize="32"
                               FontWeight="Bold" />

                    <!-- Search Box Card -->
                    <Border CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE721;"
                                      FontSize="16"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center" />

                            <!-- Query Text Box -->
                            <TextBox x:Name="SearchInputBox"
                                     Grid.Column="1"
                                     Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="What do you want to listen to? (Tracks, artists, albums, playlists)"
                                     FontSize="15"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchInputBox_KeyDown" />

                            <!-- Right Controls: ProgressRing & Clear Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,4,0">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                                              Width="20"
                                              Height="20"
                                              Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Command="{x:Bind ViewModel.ClearQueryCommand}"
                                        Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="Clear search">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. Empty Query State: Suggestions & Recent Searches -->
                <StackPanel Spacing="24"
                            Visibility="{x:Bind ViewModel.ShowSuggestions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <!-- Recent Searches (if any) -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.RecentQueries.Count, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <Grid>
                            <TextBlock Text="Recent Searches"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <HyperlinkButton Content="Clear history"
                                             Command="{x:Bind ViewModel.ClearRecentQueriesCommand}"
                                             HorizontalAlignment="Right"
                                             helpers:CursorHelper.UseHandCursor="True"
                                             FontSize="12" />
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentQueries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Click="RecentQueryButton_Click"
                                                Tag="{x:Bind}"
                                                Padding="14,8"
                                                CornerRadius="20"
                                                helpers:CursorHelper.UseHandCursor="True"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE81C;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind}" FontSize="13" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Popular Suggestion Chips -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Explore Popular Genres &amp; Tags"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        
                        <!-- Chips Wrap -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.SuggestionChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="130" ItemHeight="46" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Click="SuggestionChipButton_Click"
                                            Tag="{x:Bind}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Margin="4"
                                            Padding="12,0"
                                            CornerRadius="10"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Active Search Category Tabs (TabBar / Pill Selector) -->
                <StackPanel Spacing="16"
                            Visibility="{x:Bind ViewModel.HasQuery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- All Tab -->
                            <Button Click="TabButton_Click" Tag="0"
                                    Height="36" Padding="16,0" CornerRadius="18"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}, ConverterParameter=0}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.AllTabHeader, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=0}" />
                            </Button>

                            <!-- Tracks Tab -->
                            <Button Click="TabButton_Click" Tag="1"
                                    Height="36" Padding="16,0" CornerRadius="18"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}, ConverterParameter=1}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.TracksTabHeader, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=1}" />
                            </Button>

                            <!-- Artists Tab -->
                            <Button Click="TabButton_Click" Tag="2"
                                    Height="36" Padding="16,0" CornerRadius="18"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}, ConverterParameter=2}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.ArtistsTabHeader, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=2}" />
                            </Button>

                            <!-- Albums Tab -->
                            <Button Click="TabButton_Click" Tag="3"
                                    Height="36" Padding="16,0" CornerRadius="18"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}, ConverterParameter=3}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.AlbumsTabHeader, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=3}" />
                            </Button>

                            <!-- Playlists Tab -->
                            <Button Click="TabButton_Click" Tag="4"
                                    Height="36" Padding="16,0" CornerRadius="18"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}, ConverterParameter=4}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{x:Bind ViewModel.PlaylistsTabHeader, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=4}" />
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- No Results Placeholder -->
                    <StackPanel Spacing="16"
                                Padding="0,48"
                                HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Width="80" Height="80" CornerRadius="40" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No results found" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="Please check your spelling or try searching with different keywords."
                                   FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- TAB 0: ALL OVERVIEW -->
                    <StackPanel Spacing="32"
                                Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=0}">

                        <!-- Top Section: Best Match & Top Tracks Split -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Best Match Card (Left) -->
                            <StackPanel Grid.Column="0"
                                        Spacing="12"
                                        Visibility="{x:Bind ViewModel.BestResult, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <TextBlock Text="Best Result"
                                           FontSize="20"
                                           FontWeight="Bold" />

                                <!-- Best Result Clickable Card -->
                                <Button Click="BestResultCard_Click"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="20"
                                        CornerRadius="14"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <StackPanel Spacing="14">
                                        <!-- Best Cover & Badge -->
                                        <Grid>
                                            <Border Width="110" Height="110"
                                                    CornerRadius="{x:Bind BestResultCoverRadius(ViewModel.BestResult.Type), Mode=OneWay}"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    HorizontalAlignment="Left">
                                                <Image Source="{x:Bind ViewModel.BestResult.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Type Pill Badge -->
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Padding="10,3"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.BestResult.TypeBadge, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF" />
                                            </Border>
                                        </Grid>

                                        <!-- Title & Subtitle -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.BestResult.Title, Mode=OneWay}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="2" />
                                            <TextBlock Text="{x:Bind ViewModel.BestResult.Subtitle, Mode=OneWay}"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Preview Tracks/Albums Row (replaces bottom button) -->
                                        <Grid x:Name="BestResultPreviewContainer"
                                              SizeChanged="BestResultPreviewRow_SizeChanged"
                                              Visibility="{x:Bind ViewModel.HasBestResultPreviewCovers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.VisiblePreviewCovers, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:SearchPreviewCoverItem">
                                                        <Border Width="40" Height="40"
                                                                CornerRadius="6"
                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1"
                                                                ToolTipService.ToolTip="{x:Bind Title}">
                                                            <Grid>
                                                                <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       Stretch="UniformToFill" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Top Tracks Section (Right) -->
                            <StackPanel Grid.Column="1"
                                        Spacing="12"
                                        Visibility="{x:Bind ViewModel.Tracks.Count, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                                <Grid>
                                    <TextBlock Text="Songs"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <HyperlinkButton Click="SeeAllTracks_Click"
                                                     HorizontalAlignment="Right"
                                                     helpers:CursorHelper.UseHandCursor="True">
                                        <TextBlock Text="See all songs &gt;" FontSize="13" FontWeight="SemiBold" />
                                    </HyperlinkButton>
                                </Grid>

                                <!-- Top 5 Tracks List -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopTracks, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Track">
                                            <Button Click="TrackRow_Click"
                                                    Tag="{x:Bind}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="8,6"
                                                    Margin="0,2"
                                                    CornerRadius="8"
                                                    helpers:CursorHelper.UseHandCursor="True"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent">
                                                <Grid Height="44" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="36" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Indicator -->
                                                    <Rectangle Grid.Column="0" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                               Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                    <!-- Thumbnail -->
                                                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  Background="#99000000" CornerRadius="6">
                                                                <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Info -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind FullTitle}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind ArtistNames}"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <!-- Duration -->
                                                    <TextBlock Grid.Column="3" Text="{x:Bind FormattedDuration}"
                                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />

                                                    <!-- Like Button -->
                                                    <Button Grid.Column="4" Click="TrackLikeButton_Click" Tag="{x:Bind}"
                                                            Width="32" Height="32" Padding="0" CornerRadius="16"
                                                            Background="Transparent" BorderBrush="Transparent"
                                                            helpers:CursorHelper.UseHandCursor="True">
                                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                                  FontSize="14"
                                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                    </Button>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <!-- Artists Preview Section -->
                        <StackPanel Spacing="14"
                                    Visibility="{x:Bind ViewModel.Artists.Count, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="Artists" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <HyperlinkButton Click="SeeAllArtists_Click" HorizontalAlignment="Right" helpers:CursorHelper.UseHandCursor="True">
                                    <TextBlock Text="See all artists &gt;" FontSize="13" FontWeight="SemiBold" />
                                </HyperlinkButton>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Artists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Artist">
                                            <Button Click="ArtistCard_Click" Tag="{x:Bind}"
                                                    Padding="12" Width="150" CornerRadius="12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    helpers:CursorHelper.UseHandCursor="True">
                                                <StackPanel Spacing="10" HorizontalAlignment="Center">
                                                    <Border Width="110" Height="110" CornerRadius="55" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Image Source="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center" />
                                                    <TextBlock Text="Artist" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Albums Preview Section -->
                        <StackPanel Spacing="14"
                                    Visibility="{x:Bind ViewModel.Albums.Count, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="Albums" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <HyperlinkButton Click="SeeAllAlbums_Click" HorizontalAlignment="Right" helpers:CursorHelper.UseHandCursor="True">
                                    <TextBlock Text="See all albums &gt;" FontSize="13" FontWeight="SemiBold" />
                                </HyperlinkButton>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Albums}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Album">
                                            <Button Click="AlbumCard_Click" Tag="{x:Bind}"
                                                    Padding="12" Width="164" CornerRadius="12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    helpers:CursorHelper.UseHandCursor="True">
                                                <StackPanel Spacing="10">
                                                    <Border Width="140" Height="140" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ArtistNames}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Playlists Preview Section -->
                        <StackPanel Spacing="14"
                                    Visibility="{x:Bind ViewModel.Playlists.Count, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Grid>
                                <TextBlock Text="Playlists" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <HyperlinkButton Click="SeeAllPlaylists_Click" HorizontalAlignment="Right" helpers:CursorHelper.UseHandCursor="True">
                                    <TextBlock Text="See all playlists &gt;" FontSize="13" FontWeight="SemiBold" />
                                </HyperlinkButton>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Playlists}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:Playlist">
                                            <Button Click="PlaylistCard_Click" Tag="{x:Bind}"
                                                    Padding="12" Width="164" CornerRadius="12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    helpers:CursorHelper.UseHandCursor="True">
                                                <StackPanel Spacing="10">
                                                    <Border Width="140" Height="140" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind OwnerName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <!-- TAB 1: ALL TRACKS VIEW -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=1}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Track">
                                    <Button Click="TrackRow_Click" Tag="{x:Bind}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="12,8" Margin="0,3" CornerRadius="8"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid Height="48" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Accent Playing Indicator -->
                                            <Rectangle Grid.Column="0" Width="3" Height="20" RadiusX="1.5" RadiusY="1.5"
                                                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                       Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Cover -->
                                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Background="#99000000" CornerRadius="6">
                                                        <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Artist -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind FullTitle}" FontWeight="SemiBold" FontSize="15"
                                                           Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ArtistNames}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Album -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind AlbumTitle}" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedDuration}" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <!-- Like Button -->
                                            <Button Grid.Column="5" Click="TrackLikeButton_Click" Tag="{x:Bind}"
                                                    Width="36" Height="36" Padding="0" CornerRadius="18"
                                                    Background="Transparent" BorderBrush="Transparent"
                                                    helpers:CursorHelper.UseHandCursor="True">
                                                <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                          FontSize="16"
                                                          Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                            </Button>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Load More Tracks Button -->
                        <Button Command="{x:Bind ViewModel.LoadMoreTracksCommand}"
                                Height="40" Padding="24,0" CornerRadius="20"
                                HorizontalAlignment="Center" Margin="0,16"
                                helpers:CursorHelper.UseHandCursor="True">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingMoreTracks, Mode=OneWay}"
                                              Width="16" Height="16"
                                              Visibility="{x:Bind ViewModel.IsLoadingMoreTracks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Text="Load More Tracks" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- TAB 2: ALL ARTISTS VIEW -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=2}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="180" ItemHeight="230" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Artist">
                                    <Button Click="ArtistCard_Click" Tag="{x:Bind}"
                                            Margin="8" Padding="16" CornerRadius="14"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            helpers:CursorHelper.UseHandCursor="True">
                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                            <Border Width="130" Height="130" CornerRadius="65" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind GenresString}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TAB 3: ALL ALBUMS VIEW -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=3}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="190" ItemHeight="260" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Click="AlbumCard_Click" Tag="{x:Bind}"
                                            Margin="8" Padding="14" CornerRadius="14"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            helpers:CursorHelper.UseHandCursor="True">
                                        <StackPanel Spacing="10">
                                            <Border Width="162" Height="162" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind ArtistNames}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Year}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- TAB 4: ALL PLAYLISTS VIEW -->
                    <StackPanel Spacing="16"
                                Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=4}">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="190" ItemHeight="260" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Button Click="PlaylistCard_Click" Tag="{x:Bind}"
                                            Margin="8" Padding="14" CornerRadius="14"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            helpers:CursorHelper.UseHandCursor="True">
                                        <StackPanel Spacing="10">
                                            <Border Width="162" Height="162" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{x:Bind Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind OwnerName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TrackCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
