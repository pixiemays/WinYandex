<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="My Playlists"
                           FontSize="28"
                           FontWeight="Bold" />
                <Button Command="{x:Bind ViewModel.LoadPlaylistsCommand}"
                        Height="36"
                        ToolTipService.ToolTip="Refresh Playlists">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Playlists List -->
                    <ColumnDefinition Width="340" />
                    <!-- Selected Playlist Tracks -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Playlists column -->
                <ListView Grid.Column="0"
                          ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPlaylist, Mode=TwoWay}"
                          SelectionChanged="PlaylistListView_SelectionChanged"
                          Margin="0,0,16,0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Playlist">
                            <Grid Height="64" Padding="6,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="52"
                                        Height="52"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="20"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind TrackCount, Mode=OneTime}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Tracks column -->
                <Grid Grid.Column="1" Padding="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Playlist detail header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{x:Bind ViewModel.SelectedPlaylist, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Title, Mode=OneWay}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Command="{x:Bind ViewModel.PlayPlaylistCommand}"
                                    CommandParameter="{x:Bind ViewModel.SelectedPlaylist, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Height="32">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="Play Playlist" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Tracks in selected playlist -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.SelectedPlaylistTracks, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              ItemClick="TrackListView_ItemClick"
                              SelectionMode="None">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind FullTitle}"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind ArtistNames}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind AlbumTitle}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind FormattedDuration}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
