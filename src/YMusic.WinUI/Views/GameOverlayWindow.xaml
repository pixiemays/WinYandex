<Window
    x:Class="YMusic.WinUI.Views.GameOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootCard"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          Background="#F0111114"
          CornerRadius="18"
          BorderBrush="#18FFFFFF"
          BorderThickness="1"
          Padding="12,10"
          Opacity="1">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="CardTransform" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Track Cover Art -->
        <Border Grid.Column="0"
                Width="66"
                Height="66"
                CornerRadius="12"
                Margin="0,0,12,0"
                Background="#1AFFFFFF"
                BorderThickness="0">
            <Image x:Name="CoverImage"
                   Stretch="UniformToFill"
                   Width="66"
                   Height="66" />
        </Border>

        <!-- Track & State Info -->
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <Border Background="#22FFD300"
                        CornerRadius="5"
                        Padding="6,2">
                    <TextBlock x:Name="ActionBadgeText"
                               Text="WINYANDEX HUD"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#FFFFD300" />
                </Border>
            </StackPanel>

            <TextBlock x:Name="TitleText"
                       Text="Название трека"
                       FontSize="13.5"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFFFF"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />

            <TextBlock x:Name="ArtistText"
                       Text="Исполнитель"
                       FontSize="11.5"
                       Foreground="#99FFFFFF"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1" />
        </StackPanel>

        <!-- Right Side: Status, Like & Mini Equalizer -->
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="8,0,4,0">
            <!-- Heart icon -->
            <FontIcon x:Name="LikeIcon"
                      Glyph="&#xEB52;"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="16"
                      Foreground="#FFFF4040"
                      Visibility="Collapsed" />

            <!-- Mini Equalizer bars -->
            <StackPanel x:Name="EqualizerBars"
                        Orientation="Horizontal"
                        Spacing="3"
                        Height="16"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Border x:Name="Bar1"
                        Width="3"
                        Height="14"
                        Background="#FFFFD300"
                        CornerRadius="1.5" />
                <Border x:Name="Bar2"
                        Width="3"
                        Height="8"
                        Background="#FFFFD300"
                        CornerRadius="1.5" />
                <Border x:Name="Bar3"
                        Width="3"
                        Height="12"
                        Background="#FFFFD300"
                        CornerRadius="1.5" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

