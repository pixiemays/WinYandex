<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Grid>
        <!-- 1. Standard Login View Card -->
        <Border x:Name="LoginCard"
                Width="480"
                Padding="36"
                CornerRadius="16"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            
            <StackPanel Spacing="16">
                <!-- Brand Icon -->
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xEC4F;"
                              FontSize="28"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
                
                <TextBlock Text="Вход в Яндекс Музыку"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Войдите с помощью Яндекс ID, чтобы получить доступ к своей фонотеке, персональной «Моей волне» и плейлистам."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" />

                <!-- Error Notification -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Ошибка авторизации"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- INITIAL LOGIN PANEL -->
                <StackPanel x:Name="InitialLoginPanel" Spacing="14">
                    <!-- Primary Option: Secure Browser OAuth -->
                    <Button x:Name="SignInWithBrowserButton"
                            Click="SignInWithBrowserButton_Click"
                            HorizontalAlignment="Stretch"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="48"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="Войти через браузер"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Безопасно в вашем браузере (Chrome / Edge / Яндекс)"
                                           FontSize="11"
                                           Opacity="0.85" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Trust badge -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="15" Foreground="#2ECC71" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="Приложение не видит и не сохраняет ваш пароль. Авторизация происходит на официальном сайте Яндекса."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Divider with OR text -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="или" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="12,0" VerticalAlignment="Center" />
                        <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Secondary Option: In-App Embedded Window -->
                    <Button x:Name="SignInWithEmbeddedButton"
                            Click="SignInWithEmbeddedButton_Click"
                            HorizontalAlignment="Stretch"
                            Height="40"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                            <TextBlock Text="Войти во встроенном окне приложения"
                                       FontSize="13"
                                       FontWeight="Medium" />
                        </StackPanel>
                    </Button>

                    <!-- Manual Token Expander -->
                    <Expander Header="Ввести токен вручную"
                              HorizontalAlignment="Stretch"
                              Margin="0,4,0,0">
                        <StackPanel Spacing="12" Padding="4">
                            <TextBlock Text="Вставьте персональный токен Яндекс OAuth, если он у вас уже есть:"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <PasswordBox Password="{x:Bind ViewModel.TokenInput, Mode=TwoWay}"
                                         PlaceholderText="y0_AgAAAA..." />

                            <Button Command="{x:Bind ViewModel.LoginWithTokenCommand}"
                                    Content="Войти по токену"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <!-- BROWSER WAITING PANEL -->
                <StackPanel x:Name="BrowserWaitingPanel"
                            Visibility="Collapsed"
                            Spacing="16">
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing IsActive="True" Width="22" Height="22" />
                                <TextBlock Text="Ожидание подтверждения в браузере..."
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Мы открыли страницу авторизации Яндекс ID в вашем браузере по умолчанию. Выполните 2 простых шага:"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />

                            <!-- Steps -->
                            <StackPanel Spacing="8" Margin="4,2,0,2">
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="1" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="В браузере нажмите «Войти» или «Разрешить доступ»" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="2" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Скопируйте адресную строку (Ctrl+C) — приложение само перехватит ссылку!" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Manual Paste / Check Button -->
                    <Button x:Name="PasteFromClipboardButton"
                            Click="PasteFromClipboardButton_Click"
                            Style="{ThemeResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE16D;" FontSize="16" />
                            <TextBlock Text="Вставить ссылку из буфера обмена"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="ReopenBrowserButton"
                                Click="ReopenBrowserButton_Click"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                CornerRadius="6"
                                helpers:CursorHelper.UseHandCursor="True">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="14" />
                                <TextBlock Text="Открыть браузер" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                x:Name="CancelBrowserAuthButton"
                                Click="CancelBrowserAuthButton_Click"
                                HorizontalAlignment="Stretch"
                                Height="36"
                                CornerRadius="6"
                                helpers:CursorHelper.UseHandCursor="True">
                            <TextBlock Text="Отмена" FontSize="12" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Loading spinner -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 2. Embedded WebView2 OAuth Overlay (With Security Trust Bar) -->
        <Grid x:Name="OAuthOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar with Back/Cancel button and SSL Trust Indicator -->
            <Grid Grid.Row="0"
                  Padding="16,10"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelOAuthButton"
                        Click="CancelOAuthButton_Click"
                        Height="34"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                        <TextBlock Text="Назад" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- Security Trust Bar -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14,4"
                        Margin="0,0,80,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="#2ECC71" VerticalAlignment="Center" />
                        <TextBlock Text="oauth.yandex.ru" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="• Защищённое соединение Яндекс ID" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- WebView2 Browser -->
            <Grid Grid.Row="1">
                <WebView2 x:Name="OAuthWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          NavigationStarting="OAuthWebView_NavigationStarting"
                          NavigationCompleted="OAuthWebView_NavigationCompleted" />

                <ProgressRing x:Name="WebViewProgressRing"
                              IsActive="True"
                              Width="44"
                              Height="44"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
