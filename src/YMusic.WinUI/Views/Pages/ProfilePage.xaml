<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="36,28,36,48">
        <StackPanel MaxWidth="880" HorizontalAlignment="Stretch" Spacing="28">

            <!-- Page Title -->
            <StackPanel Spacing="6">
                <TextBlock Text="Profile &amp; Settings"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Manage your Yandex account, playback preferences, and application options"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Feedback / Status InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasNotification, Mode=OneWay}"
                     Severity="Informational"
                     Title="Settings"
                     Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="NotificationInfoBar_CloseButtonClick" />

            <!-- ========================================== -->
            <!-- 1. USER PROFILE SECTION                   -->
            <!-- ========================================== -->
            <!-- Logged In Card -->
            <Border Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="24"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- User Avatar with Border -->
                        <Border Grid.Column="0"
                                Width="84"
                                Height="84"
                                CornerRadius="42"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                Margin="0,0,20,0">
                            <PersonPicture Width="80"
                                           Height="80"
                                           DisplayName="{x:Bind ViewModel.User.DisplayName, Mode=OneWay}"
                                           ProfilePicture="{x:Bind ViewModel.User.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.User.DisplayName, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold" />
                                
                                <!-- Yandex Plus Badge -->
                                <Border Padding="8,3"
                                        CornerRadius="12"
                                        Background="#FFD700"
                                        Visibility="{x:Bind ViewModel.User.HasPlus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#000000" />
                                        <TextBlock Text="PLUS" FontSize="11" FontWeight="Bold" Foreground="#000000" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind FormatLogin(ViewModel.User.Login), Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                
                                <TextBlock Text="•"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind HasEmail(ViewModel.User.DefaultEmail), Mode=OneWay}" />
                                
                                <TextBlock Text="{x:Bind ViewModel.User.DefaultEmail, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasEmail(ViewModel.User.DefaultEmail), Mode=OneWay}" />
                            </StackPanel>

                            <!-- UID Pill with Copy Button -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Border Padding="8,2"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind FormatUid(ViewModel.User.UserId), Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontFamily="Consolas" />
                                </Border>
                                <Button Command="{x:Bind ViewModel.CopyUserIdCommand}"
                                        Padding="6,2"
                                        Height="24"
                                        CornerRadius="6"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="Copy User ID">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Profile Action Buttons -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Top">
                            <Button Command="{x:Bind ViewModel.RefreshProfileCommand}"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="Refresh" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.LogoutCommand}"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF3B1;" FontSize="13" Foreground="#FF5555" />
                                    <TextBlock Text="Sign Out" FontSize="13" Foreground="#FF5555" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Quick Stats Row -->
                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Liked Tracks Stat -->
                        <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.NavigateToLikesCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#33FF0055">
                                    <FontIcon Glyph="&#xEB52;" FontSize="18" Foreground="#FF3366" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Liked Tracks" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LikedTracksCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Playlists Stat -->
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.NavigateToPlaylistsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#330078D4">
                                    <FontIcon Glyph="&#xE142;" FontSize="18" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Playlists" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PlaylistsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Pinned Items Stat -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.NavigateToPlaylistsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#33107C41">
                                    <FontIcon Glyph="&#xE718;" FontSize="18" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Pinned Items" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PinnedItemsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Logged Out Card -->
            <Border Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Padding="24"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="You are currently signed out" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Sign in with your Yandex ID to sync your collection, My Wave recommendations, liked tracks and playlists."
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.NavigateToLoginCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="40"
                            Padding="20,0"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="Sign In with Yandex ID" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. AUDIO & PLAYBACK SETTINGS              -->
            <!-- ========================================== -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEC4F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Audio &amp; Playback" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Stream Quality Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Default Streaming Quality" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Preferred audio codec and bitrate for streaming tracks" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{x:Bind ViewModel.SelectedQualityIndex, Mode=TwoWay}"
                                      Width="240"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="AAC (192–256 kbps) • Recommended" />
                                <ComboBoxItem Content="MP3 (320 kbps) • Constant Bitrate" />
                                <ComboBoxItem Content="Highest Bitrate Available" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Gapless Preloading Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Gapless Playback &amp; Background Preloading" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Preloads the next track stream and lyrics at 80% progress to eliminate buffering pauses" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsGaplessPreloadEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Equalizer Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Audio Equalizer" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="10-band audio frequency equalizer and acoustic profiles" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailablePresets}"
                                          SelectedItem="{x:Bind ViewModel.SelectedEqualizerPreset, Mode=TwoWay}"
                                          Width="150"
                                          IsEnabled="{x:Bind ViewModel.IsEqualizerEnabled, Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.ResetEqualizerCommand}"
                                        Content="Reset"
                                        Padding="12,6"
                                        IsEnabled="{x:Bind ViewModel.IsEqualizerEnabled, Mode=OneWay}"
                                        helpers:CursorHelper.UseHandCursor="True" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsEqualizerEnabled, Mode=TwoWay}"
                                              OnContent="On"
                                              OffContent="Off" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. INTEGRATIONS & SYSTEM                  -->
            <!-- ========================================== -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="System &amp; Integrations" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Discord RPC Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Discord Rich Presence" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Show current playing track title, artist name, and album artwork on your Discord profile" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsDiscordRpcEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- FckCensor Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="FckCensor (Uncensored Audio)" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Automatically prefer original explicit and uncensored versions of tracks over sanitized edits" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsFckCensorEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Minimize to Tray Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Minimize to Windows System Tray" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Keep music playing in background and minimize to the taskbar notification tray when window is closed" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsMinimizeToTrayEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows Toast Notifications Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Windows Toast Notifications" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Show native desktop banner notifications when track changes while playing in background" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsTrackNotificationsEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Application Theme Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Application Theme" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Select your visual appearance preference" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                      Width="180"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="System Default" />
                                <ComboBoxItem Content="Dark Mode" />
                                <ComboBoxItem Content="Light Mode" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Language Selection Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Language / Язык" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Switch interface language instantly / Смена языка интерфейса без перезапуска" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                      Width="180"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Русский (RU)" />
                                <ComboBoxItem Content="English (EN)" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 4. STORAGE & DATA MANAGEMENT              -->
            <!-- ========================================== -->
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="Storage &amp; Data" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Audio Disk Cache (LRU) Toggle Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Audio Disk Cache (LRU)" FontSize="14" FontWeight="SemiBold" />
                                    <Border Padding="6,1.5" CornerRadius="4" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="Instant Replay" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Save played tracks offline in %LocalAppData%/YMusic/Cache for instant 0 ms replay without network re-downloading"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsAudioCacheEnabled, Mode=TwoWay}"
                                          OnContent="Enabled"
                                          OffContent="Disabled"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Cache Size Limit Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Cache Storage Limit" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Automatically evicts least recently played tracks (LRU) when local cache exceeds this quota"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{x:Bind ViewModel.SelectedCacheLimitIndex, Mode=TwoWay}"
                                      Width="180"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="512 MB" />
                                <ComboBoxItem Content="1 GB (Recommended)" />
                                <ComboBoxItem Content="2 GB" />
                                <ComboBoxItem Content="4 GB" />
                                <ComboBoxItem Content="8 GB" />
                                <ComboBoxItem Content="16 GB" />
                                <ComboBoxItem Content="Unlimited" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Cache Size & Clear Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Local Audio &amp; Metadata Cache" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Storage occupied:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Cached items:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CachedTracksCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.OpenCacheFolderCommand}"
                                        Padding="12,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="Open Cache/Audio folder in Explorer">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                        <TextBlock Text="Open Cache" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ClearCacheCommand}"
                                        Content="Clear Cache"
                                        Padding="14,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- App Data Directory Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Application Data Folder" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AppDataPath, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Consolas" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.OpenAppDataFolderCommand}"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                    <TextBlock Text="Open in Explorer" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clear Search History Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Search History" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Clear recent search queries saved on this device" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.ClearSearchHistoryCommand}"
                                    Content="Clear History"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 5. ABOUT APP                              -->
            <!-- ========================================== -->
            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="WinYandex Music" FontSize="16" FontWeight="Bold" />
                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBlock Text="{x:Bind ViewModel.AppVersionText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Modern desktop client for Yandex Music built with WinUI 3, Windows App SDK &amp; .NET 8."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.OpenGitHubCommand}"
                            Padding="14,8"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71B;" FontSize="13" />
                            <TextBlock Text="GitHub Repository" FontSize="13" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
