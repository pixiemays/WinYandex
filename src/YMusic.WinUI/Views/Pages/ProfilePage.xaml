<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    xmlns:interfaces="using:YMusic.WinUI.Services.Interfaces"
    xmlns:models="using:YMusic.WinUI.Models"
    mc:Ignorable="d">

    <ScrollViewer x:Name="PageScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Spacing="18" Padding="36,24,36,48">

            <!-- Page Title -->
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Bind ViewModel.TitleText, Mode=OneWay}"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}"
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Settings Segmented Navigation Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="4"
                    Margin="0,2,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <!-- Profile Tab -->
                        <Button Click="CategoryPill_Click" Tag="1"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=1}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryProfileText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=1}" />
                            </StackPanel>
                        </Button>

                        <!-- Audio Tab -->
                        <Button Click="CategoryPill_Click" Tag="2"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=2}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEC4F;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=2}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryAudioText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=2}" />
                            </StackPanel>
                        </Button>

                        <!-- Appearance Tab -->
                        <Button Click="CategoryPill_Click" Tag="3"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=3}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryAppearanceText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=3}" />
                            </StackPanel>
                        </Button>

                        <!-- Integrations Tab -->
                        <Button Click="CategoryPill_Click" Tag="4"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=4}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEB51;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=4}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryIntegrationsText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=4}" />
                            </StackPanel>
                        </Button>

                        <!-- System Tab -->
                        <Button Click="CategoryPill_Click" Tag="5"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=5}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE713;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=5}" />
                                <TextBlock Text="{x:Bind ViewModel.CategorySystemText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=5}" />
                            </StackPanel>
                        </Button>

                        <!-- Storage Tab -->
                        <Button Click="CategoryPill_Click" Tag="6"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=6}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEDA2;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=6}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryStorageText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=6}" />
                            </StackPanel>
                        </Button>

                        <!-- About Tab -->
                        <Button Click="CategoryPill_Click" Tag="7"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=7}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=7}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryAboutText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=7}" />
                            </StackPanel>
                        </Button>

                        <!-- All Tab -->
                        <Button Click="CategoryPill_Click" Tag="0"
                                Style="{StaticResource SettingsSegmentButtonStyle}"
                                Background="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToSegmentBackgroundConverter}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE81D;" FontSize="13" Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=0}" />
                                <TextBlock Text="{x:Bind ViewModel.CategoryAllText, Mode=OneWay}"
                                           FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{x:Bind ViewModel.SelectedCategoryIndex, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}, ConverterParameter=0}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Feedback / Status InfoBar -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasNotification, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.HasNotification, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                     Severity="Informational"
                     Title="{x:Bind ViewModel.NotificationTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.NotificationMessage, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="NotificationInfoBar_CloseButtonClick" />

            <!-- ========================================== -->
            <!-- DYNAMIC SETTINGS CONTENT CONTAINER         -->
            <!-- ========================================== -->
            <Grid x:Name="SettingsContentContainer">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ContentTranslateTransform" Y="0" />
                </Grid.RenderTransform>

                <StackPanel Spacing="18">
            <!-- ========================================== -->
            <!-- 1. USER PROFILE SECTION                   -->
            <!-- ========================================== -->
            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.ShowProfileSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Logged In Card -->
                <Border Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Padding="24"
                        CornerRadius="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                <StackPanel Spacing="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- User Avatar with Border -->
                        <Border Grid.Column="0"
                                Width="84"
                                Height="84"
                                CornerRadius="42"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                Margin="0,0,20,0">
                            <PersonPicture Width="80"
                                           Height="80"
                                           DisplayName="{x:Bind ViewModel.User.DisplayName, Mode=OneWay}"
                                           ProfilePicture="{x:Bind ViewModel.User.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" />
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.User.DisplayName, Mode=OneWay}"
                                           FontSize="22"
                                           FontWeight="Bold" />
                                
                                <!-- Yandex Plus Badge -->
                                <Border Padding="8,3"
                                        CornerRadius="12"
                                        Background="#FFD700"
                                        Visibility="{x:Bind ViewModel.User.HasPlus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#000000" />
                                        <TextBlock Text="PLUS" FontSize="11" FontWeight="Bold" Foreground="#000000" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{x:Bind FormatLogin(ViewModel.User.Login), Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                
                                <TextBlock Text="•"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind HasEmail(ViewModel.User.DefaultEmail), Mode=OneWay}" />
                                
                                <TextBlock Text="{x:Bind ViewModel.User.DefaultEmail, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasEmail(ViewModel.User.DefaultEmail), Mode=OneWay}" />
                            </StackPanel>

                            <!-- UID Pill with Copy Button -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <Border Padding="8,2"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind FormatUid(ViewModel.User.UserId), Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               FontFamily="Consolas" />
                                </Border>
                                <Button Command="{x:Bind ViewModel.CopyUserIdCommand}"
                                        Padding="6,2"
                                        Height="24"
                                        CornerRadius="6"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CopyUserIdTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Profile Action Buttons -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Top">
                            <Button Command="{x:Bind ViewModel.RefreshProfileCommand}"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.RefreshButtonText, Mode=OneWay}" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.LogoutCommand}"
                                    Padding="12,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF3B1;" FontSize="13" Foreground="#FF5555" />
                                    <TextBlock Text="{x:Bind ViewModel.SignOutButtonText, Mode=OneWay}" FontSize="13" Foreground="#FF5555" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Quick Stats Row -->
                    <Grid ColumnSpacing="12" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Liked Tracks Stat -->
                        <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.NavigateToLikesCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#33FF0055">
                                    <FontIcon Glyph="&#xEB52;" FontSize="18" Foreground="#FF3366" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.LikedTracksStatText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.LikedTracksCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Playlists Stat -->
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.NavigateToPlaylistsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#330078D4">
                                    <FontIcon Glyph="&#xE142;" FontSize="18" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.PlaylistsStatText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PlaylistsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        <!-- Pinned Items Stat -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.NavigateToPlaylistsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Padding="16,14"
                                CornerRadius="10"
                                helpers:CursorHelper.UseHandCursor="True"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderThickness="0">
                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="8" Background="#33107C41">
                                    <FontIcon Glyph="&#xE718;" FontSize="18" Foreground="#107C41" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.PinnedItemsStatText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PinnedItemsCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Logged Out Card -->
            <Border Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                    Padding="24"
                    CornerRadius="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.SignedOutTitleText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SignedOutDescText, Mode=OneWay}"
                                   FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.NavigateToLoginCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="40"
                            Padding="20,0"
                            CornerRadius="8"
                            helpers:CursorHelper.UseHandCursor="True"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE77B;" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 2. AUDIO & PLAYBACK SETTINGS              -->
            <!-- ========================================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowAudioSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEC4F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AudioSectionTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Stream Quality Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.StreamQualityTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.StreamQualityDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.QualityOptions, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedQualityIndex, Mode=TwoWay}"
                                      MinWidth="300"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Gapless Preloading Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.GaplessTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.GaplessDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsGaplessPreloadEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Smart Crossfade Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.CrossfadeTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.CrossfadeDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsCrossfadeEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />

                            <!-- Crossfade Duration Slider -->
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0"
                                        Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsCrossfadeEnabled, Mode=OneWay}">
                                <Slider Minimum="1" Maximum="10" StepFrequency="1"
                                        Value="{x:Bind ViewModel.CrossfadeDurationSeconds, Mode=TwoWay}"
                                        Width="200" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.CrossfadeDurationText, Mode=OneWay}"
                                           FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Equalizer Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.EqualizerTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.EqualizerDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{x:Bind ViewModel.AvailablePresets}"
                                          SelectedItem="{x:Bind ViewModel.SelectedEqualizerPreset, Mode=TwoWay}"
                                          MinWidth="150"
                                          HorizontalAlignment="Right"
                                          IsEnabled="{x:Bind ViewModel.IsEqualizerEnabled, Mode=OneWay}" />
                                <Button Command="{x:Bind ViewModel.ResetEqualizerCommand}"
                                        Content="{x:Bind ViewModel.EqualizerResetText, Mode=OneWay}"
                                        Padding="12,6"
                                        IsEnabled="{x:Bind ViewModel.IsEqualizerEnabled, Mode=OneWay}"
                                        helpers:CursorHelper.UseHandCursor="True" />
                                <ToggleSwitch IsOn="{x:Bind ViewModel.IsEqualizerEnabled, Mode=TwoWay}"
                                              OnContent="{x:Bind ViewModel.SwitchOnText, Mode=OneWay}"
                                              OffContent="{x:Bind ViewModel.SwitchOffText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 4. INTEGRATIONS                           -->
            <!-- ========================================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowIntegrationsSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xEB51;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.IntegrationsSectionTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Discord RPC Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.DiscordRpcTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.DiscordRpcDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsDiscordRpcEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- OBS Studio Overlay Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.ObsOverlayTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.ObsOverlayDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.IsObsOverlayEnabled, Mode=TwoWay}"
                                              OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                              OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind ViewModel.ObsWidgetUrlText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             VerticalAlignment="Center"
                                             FontSize="12" />
                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.CopyObsUrlCommand}"
                                            ToolTipService.ToolTip="Скопировать ссылку для вставки в OBS Browser Source"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.CopyObsUrlButtonText, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Command="{x:Bind ViewModel.OpenObsDashboardCommand}"
                                            ToolTipService.ToolTip="Открыть веб-панель управления виджетом в браузере"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.OpenObsDashboardButtonText, Mode=OneWay}" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- In-Game HUD Overlay Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.GameOverlayTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.GameOverlayDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.IsGameOverlayEnabled, Mode=TwoWay}"
                                              OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                              OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <!-- Sub-settings for HUD Overlay -->
                            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsGameOverlayEnabled, Mode=OneWay}">
                                <!-- Show on Track Change Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,16,0">
                                        <TextBlock Text="{x:Bind ViewModel.ShowOverlayOnTrackChangeTitle, Mode=OneWay}" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.ShowOverlayOnTrackChangeDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.IsShowOverlayOnTrackChangeEnabled, Mode=TwoWay}"
                                                  OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                  OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>

                                <!-- Duration Slider -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.GameOverlayDurationText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Slider Minimum="2" Maximum="7" StepFrequency="1"
                                            Value="{x:Bind ViewModel.GameOverlayDurationSeconds, Mode=TwoWay}"
                                            VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Interactive Screen Position Selector -->
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,4,0,0">
                                    <StackPanel Spacing="12">
                                        <!-- Header: Title, Selected Badge, Test Button -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.GameOverlayPositionTitle, Mode=OneWay}"
                                                           FontSize="13" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="Выбрано:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedOverlayPositionName, Mode=OneWay}"
                                                               FontSize="11" FontWeight="SemiBold" Foreground="#FFFFD300" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Test Overlay Button -->
                                            <Button Grid.Column="1"
                                                    Command="{x:Bind ViewModel.TestGameOverlayCommand}"
                                                    Height="32"
                                                    Padding="12,0"
                                                    CornerRadius="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="#FFFFD300" />
                                                    <TextBlock Text="{x:Bind ViewModel.TestGameOverlayButtonText, Mode=OneWay}" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Mini Monitor Screen Graphic -->
                                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                                            <Border Width="270"
                                                    Height="136"
                                                    Background="#FF101014"
                                                    BorderBrush="#33FFFFFF"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Top Row -->
                                                    <Button Grid.Row="0" Grid.Column="0"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="1"
                                                            Background="{x:Bind ViewModel.PosTopLeftBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosTopLeftForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0">
                                                        <TextBlock Text="Слева" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <Button Grid.Row="0" Grid.Column="1"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="4"
                                                            Background="{x:Bind ViewModel.PosTopCenterBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosTopCenterForeground, Mode=OneWay}"
                                                            Height="26" Width="74" Padding="0" CornerRadius="5" BorderThickness="0"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="Вверху" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <Button Grid.Row="0" Grid.Column="2"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="0"
                                                            Background="{x:Bind ViewModel.PosTopRightBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosTopRightForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0">
                                                        <TextBlock Text="Справа" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <!-- Middle Row (Sides) -->
                                                    <Button Grid.Row="1" Grid.Column="0"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="6"
                                                            Background="{x:Bind ViewModel.PosMiddleLeftBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosMiddleLeftForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Бок Л" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <Button Grid.Row="1" Grid.Column="2"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="7"
                                                            Background="{x:Bind ViewModel.PosMiddleRightBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosMiddleRightForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="Бок П" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <!-- Bottom Row -->
                                                    <Button Grid.Row="2" Grid.Column="0"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="3"
                                                            Background="{x:Bind ViewModel.PosBottomLeftBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosBottomLeftForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0">
                                                        <TextBlock Text="Слева" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <Button Grid.Row="2" Grid.Column="1"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="5"
                                                            Background="{x:Bind ViewModel.PosBottomCenterBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosBottomCenterForeground, Mode=OneWay}"
                                                            Height="26" Width="74" Padding="0" CornerRadius="5" BorderThickness="0"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="Внизу" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>

                                                    <Button Grid.Row="2" Grid.Column="2"
                                                            Command="{x:Bind ViewModel.SetOverlayPositionCommand}"
                                                            CommandParameter="2"
                                                            Background="{x:Bind ViewModel.PosBottomRightBrush, Mode=OneWay}"
                                                            Foreground="{x:Bind ViewModel.PosBottomRightForeground, Mode=OneWay}"
                                                            Height="26" Width="66" Padding="0" CornerRadius="5" BorderThickness="0">
                                                        <TextBlock Text="Справа" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- Monitor Stand -->
                                            <Border Width="48" Height="4" Background="#33FFFFFF" CornerRadius="2" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 5. SYSTEM & GENERAL SETTINGS              -->
            <!-- ========================================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowSystemSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.CategorySystemText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Global Hotkeys Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.GlobalHotkeysTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.GlobalHotkeysDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsGlobalHotkeysEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Autoplay Wave on Album End Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.AutoplayWaveTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AutoplayWaveDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsAutoplayWaveEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Auto Bypass Proxy for Yandex Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.AutoBypassProxyTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AutoBypassProxyDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsAutoBypassProxyEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- FckCensor Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.FckCensorTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.FckCensorDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <HyperlinkButton Command="{x:Bind ViewModel.OpenFckCensorRepoCommand}"
                                                 Padding="0"
                                                 Margin="0,2,0,0"
                                                 helpers:CursorHelper.UseHandCursor="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.FckCensorAuthorCreditText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsFckCensorEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Slopless AI Music Filter Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <!-- Main Switch Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.SloplessTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.SloplessDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <HyperlinkButton Command="{x:Bind ViewModel.OpenSloplessRepoCommand}"
                                                     Padding="0"
                                                     Margin="0,2,0,0"
                                                     helpers:CursorHelper.UseHandCursor="True">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SloplessAuthorCreditText, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </StackPanel>
                                    </HyperlinkButton>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.IsSloplessEnabled, Mode=TwoWay}"
                                              OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                              OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <!-- Collapsible Settings Panel -->
                            <StackPanel Spacing="12"
                                        Visibility="{x:Bind ViewModel.IsSloplessEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="0,6,0,0">
                                <MenuFlyoutSeparator Margin="0,0,0,6" />

                                <!-- Behavior Option -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SloplessBehaviorTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.SloplessBehaviorDesc, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Bind ViewModel.SloplessBehaviorOptions}"
                                              SelectedIndex="{x:Bind ViewModel.SloplessBehaviorIndex, Mode=TwoWay}"
                                              MinWidth="240"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- Detection Mode Option -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SloplessDetectionModeTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.SloplessDetectionModeDesc, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{x:Bind ViewModel.SloplessDetectionModeOptions}"
                                              SelectedIndex="{x:Bind ViewModel.SloplessDetectionModeIndex, Mode=TwoWay}"
                                              MinWidth="240"
                                              VerticalAlignment="Center" />
                                </Grid>

                                <!-- Artist Threshold Slider -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SloplessArtistThresholdTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.SloplessArtistThresholdDesc, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider Minimum="1" Maximum="100" StepFrequency="1"
                                                Value="{x:Bind ViewModel.SloplessArtistThreshold, Mode=TwoWay}"
                                                Width="180" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ViewModel.SloplessArtistThresholdText, Mode=OneWay}"
                                                   Width="40" TextAlignment="Right" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <!-- Show Track Badges Toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SloplessShowTrackLabelsTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ViewModel.SloplessShowTrackLabelsDesc, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  IsOn="{x:Bind ViewModel.IsSloplessShowTrackLabelsEnabled, Mode=TwoWay}"
                                                  OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                  OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Minimize to Tray Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.MinimizeToTrayTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.MinimizeToTrayDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsMinimizeToTrayEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Windows Toast Notifications Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.TrackNotificationsTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.TrackNotificationsDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsTrackNotificationsEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Language Selection Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.LanguageTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.LanguageDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      SelectedIndex="{x:Bind ViewModel.SelectedLanguageIndex, Mode=TwoWay}"
                                      MinWidth="180"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Русский (RU)" />
                                <ComboBoxItem Content="English (EN)" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 3. APPEARANCE & CUSTOMIZATION             -->
            <!-- ========================================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowAppearanceSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.AppearanceSectionTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Application Theme Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.ThemeTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.ThemeDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                          MinWidth="260"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center" />
                            </Grid>

                            <!-- Theme Quick Actions: Open Folder / Import / Export -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{x:Bind ViewModel.OpenThemesFolderCommand}"
                                        Padding="12,6"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="Открыть папку тем в Проводнике (Ctrl+S в файле темы для Hot-Reload)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.OpenThemesFolderButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ImportThemeCommand}"
                                        Padding="12,6"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="Импортировать тему из файла (.wytheme, .zip, .json)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.ImportThemeButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ExportCurrentThemeCommand}"
                                        Padding="12,6"
                                        CornerRadius="6"
                                        ToolTipService.ToolTip="Экспортировать текущую тему в архив .wytheme">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.ExportThemeButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Community Themes Catalog Showcase -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xEC05;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CommunityThemesTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.CommunityThemesDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Click="OpenCommunityCatalog_Click"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CommunityThemesCatalogTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.CommunityThemesCatalogButtonText, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        Command="{x:Bind ViewModel.LoadCommunityThemesCommand}"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RefreshButtonText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.RefreshButtonText, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3"
                                        Command="{x:Bind ViewModel.ToggleCommunityThemesExpandedCommand}"
                                        Padding="10,6"
                                        CornerRadius="6"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CommunityThemesToggleTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="{x:Bind ViewModel.CommunityThemesChevronGlyph, Mode=OneWay}" FontSize="11" />
                                        <TextBlock Text="{x:Bind ViewModel.CommunityThemesToggleText, Mode=OneWay}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Collapsible Content ("Шторка") -->
                            <StackPanel Visibility="{x:Bind ViewModel.IsCommunityThemesExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.NoCommunityThemesText, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.ShowNoCommunityThemesMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Margin="4,4,4,0" />

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollMode="Enabled"
                                              VerticalScrollMode="Disabled">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CommunityThemes, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CommunityThemeItem">
                                                <Border Width="240"
                                                        Padding="12"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <Grid RowSpacing="8">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Preview Thumbnail (Image) -->
                                                        <Border Grid.Row="0"
                                                                Height="115"
                                                                HorizontalAlignment="Stretch"
                                                                CornerRadius="6"
                                                                helpers:CursorHelper.UseHandCursor="True"
                                                                Tag="{x:Bind}"
                                                                Tapped="PreviewImage_Tapped"
                                                                ToolTipService.ToolTip="{x:Bind PreviewTooltip, Mode=OneWay}"
                                                                Visibility="{x:Bind HasPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{x:Bind PreviewUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                            Stretch="UniformToFill" />
                                                            </Border.Background>
                                                            <Border HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom"
                                                                    Margin="6"
                                                                    Padding="7,3"
                                                                    CornerRadius="10"
                                                                    Background="#C0121215">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <FontIcon Glyph="&#xE71E;" FontSize="9" Foreground="White" />
                                                                    <TextBlock Text="Просмотр" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Border>

                                                        <!-- Accent Strip -->
                                                        <Border Grid.Row="1"
                                                                Height="3"
                                                                CornerRadius="1.5"
                                                                Background="{x:Bind AccentColor, Converter={StaticResource HexToBrushConverter}}" />

                                                        <!-- Title & Author -->
                                                        <StackPanel Grid.Row="2" Spacing="2">
                                                            <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Author}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <!-- Description -->
                                                        <TextBlock Grid.Row="3"
                                                                   Text="{x:Bind Description}"
                                                                   FontSize="11.5"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   MaxLines="3"
                                                                   MinHeight="44" />

                                                        <!-- Action Buttons: Main (Apply/Download) + Link -->
                                                        <Grid Grid.Row="4" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Button Grid.Column="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    Padding="0,6"
                                                                    CornerRadius="6"
                                                                    Tag="{x:Bind}"
                                                                    Click="InstallCommunityTheme_Click"
                                                                    Opacity="{x:Bind ActionButtonOpacity, Mode=OneWay}"
                                                                    IsEnabled="{x:Bind CanAction, Mode=OneWay}"
                                                                    Style="{ThemeResource AccentButtonStyle}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                                    <FontIcon Glyph="{x:Bind ActionButtonGlyph, Mode=OneWay}" FontSize="12" />
                                                                    <TextBlock Text="{x:Bind ActionButtonText, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Grid.Column="1"
                                                                    Padding="8,6"
                                                                    CornerRadius="6"
                                                                    Tag="{x:Bind}"
                                                                    Click="OpenCommunityThemeLink_Click"
                                                                    ToolTipService.ToolTip="{x:Bind OpenLinkTooltip, Mode=OneWay}">
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Window Backdrop Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.BackdropTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.BackdropDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.BackdropOptions, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedBackdropIndex, Mode=TwoWay}"
                                      MinWidth="240"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Accent Color Customization Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4" Margin="0,0,16,0">
                                    <TextBlock Text="{x:Bind ViewModel.AccentTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.AccentDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Active Accent Preview Pill -->
                                <Border Grid.Column="1" Padding="10,5" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{x:Bind ViewModel.CurrentAccentHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}" BorderThickness="1" BorderBrush="#33FFFFFF" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentAccentHex, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Consolas, Cascadia Mono, monospace" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Preset Color Badges -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableAccents}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="interfaces:AccentPreset">
                                        <Button Click="AccentPreset_Click"
                                                Tag="{x:Bind}"
                                                Padding="2"
                                                CornerRadius="18"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTipService.ToolTip="{x:Bind Name}">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{x:Bind Brush}" BorderThickness="2" BorderBrush="#40FFFFFF" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom HEX Input Row -->
                            <Grid ColumnSpacing="10" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{x:Bind ViewModel.CustomHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.CustomHexPlaceholder, Mode=OneWay}"
                                         MaxLength="9"
                                         FontFamily="Consolas, Cascadia Mono, monospace"
                                         VerticalAlignment="Center">
                                    <TextBox.Header>
                                        <TextBlock Text="{x:Bind ViewModel.CustomColorTitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </TextBox.Header>
                                </TextBox>
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.ApplyCustomHexCommand}"
                                        VerticalAlignment="Bottom"
                                        Height="32"
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8FB;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.ApplyHexButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- UI Font Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.FontTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.FontDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.FontOptions, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedFontIndex, Mode=TwoWay}"
                                      MinWidth="240"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Modular Interface Customization Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74C;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.ModularUiTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ModularUiDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 1. Navigation Sidebar Sub-section -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.NavSectionTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />

                                    <!-- Show Search in Nav -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowSearchTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowSearchDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowSearchInNavEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Wave in Nav -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowWaveTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowWaveDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowWaveInNavEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Likes in Nav -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowLikesTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowLikesDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowLikesInNavEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Playlists in Nav -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowPlaylistsTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowPlaylistsDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowPlaylistsInNavEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Bottom Player Bar Sub-section -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.PlayerModularTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />

                                    <!-- Show Lyrics Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowLyricsTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowLyricsDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowLyricsButtonEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Equalizer Button -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowEqualizerTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowEqualizerDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowEqualizerButtonEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Quality Badge -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowQualityBadgeTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowQualityDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowQualityBadgeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Compact Volume Slider -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.CompactVolumeTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.CompactVolumeDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsCompactPlayerVolumeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Home / Explore Page Sub-section -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Padding="14,12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{x:Bind ViewModel.HomeModularTitle, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />

                                    <!-- Show Personal Playlists -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowPersonalPlaylistsTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowPersonalPlaylistsDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowPersonalPlaylistsOnHomeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show New Releases -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowNewReleasesTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowNewReleasesDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowNewReleasesOnHomeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Editorial Playlists -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowEditorialPlaylistsTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowEditorialPlaylistsDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowEditorialPlaylistsOnHomeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Show Chart -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2" Margin="0,0,16,0">
                                            <TextBlock Text="{x:Bind ViewModel.ShowChartTitle, Mode=OneWay}" FontSize="12.5" />
                                            <TextBlock Text="{x:Bind ViewModel.ShowChartDesc, Mode=OneWay}" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1"
                                                      IsOn="{x:Bind ViewModel.IsShowChartOnHomeEnabled, Mode=TwoWay}"
                                                      OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                                      OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 6. STORAGE & DATA MANAGEMENT              -->
            <!-- ========================================== -->
            <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ShowStorageSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StorageSectionTitle, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <!-- Audio Disk Cache (LRU) Toggle Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.AudioCacheTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                    <Border Padding="6,1.5" CornerRadius="4" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.InstantReplayText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.AudioCacheDesc, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsOn="{x:Bind ViewModel.IsAudioCacheEnabled, Mode=TwoWay}"
                                          OnContent="{x:Bind ViewModel.SwitchEnabledText, Mode=OneWay}"
                                          OffContent="{x:Bind ViewModel.SwitchDisabledText, Mode=OneWay}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Audio Cache Location Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.CacheLocationTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.CacheLocationDesc, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CurrentCachePath, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentCachePath, Mode=OneWay}"
                                                   FontSize="12"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="480" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.ResetCacheFolderCommand}"
                                        Visibility="{x:Bind ViewModel.IsCustomCachePath, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Padding="12,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ResetCacheFolderTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.ResetCacheFolderButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ChangeCacheFolderCommand}"
                                        Padding="14,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.ChangeCacheFolderButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cache Size Limit Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.CacheLimitTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.CacheLimitDesc, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.CacheLimitOptions, Mode=OneWay}"
                                      SelectedIndex="{x:Bind ViewModel.SelectedCacheLimitIndex, Mode=TwoWay}"
                                      MinWidth="240"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Cache Size & Clear Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.LocalStorageTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.StorageOccupiedText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CacheSizeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.CachedItemsText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CachedTracksCountText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.OpenCacheFolderCommand}"
                                        Padding="12,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.OpenCacheTooltip, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                        <TextBlock Text="{x:Bind ViewModel.OpenCacheButtonText, Mode=OneWay}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ClearCacheCommand}"
                                        Content="{x:Bind ViewModel.ClearCacheButtonText, Mode=OneWay}"
                                        Padding="14,8"
                                        CornerRadius="8"
                                        helpers:CursorHelper.UseHandCursor="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- App Data Directory Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.AppDataFolderTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.AppDataPath, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontFamily="Consolas" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.OpenAppDataFolderCommand}"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.OpenInExplorerButtonText, Mode=OneWay}" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Clear Search History Card -->
                    <Border Padding="18,16" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind ViewModel.SearchHistoryTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind ViewModel.SearchHistoryDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.ClearSearchHistoryCommand}"
                                    Content="{x:Bind ViewModel.ClearHistoryButtonText, Mode=OneWay}"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True"
                                    VerticalAlignment="Center">
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ========================================== -->
            <!-- 7. ABOUT & UPDATES                        -->
            <!-- ========================================== -->
            <Border x:Name="AboutAndUpdatesSection"
                    Visibility="{x:Bind ViewModel.ShowAboutSection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="WinYandex Music" FontSize="16" FontWeight="Bold" />
                                <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.AboutDescText, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanCheckUpdates, Mode=OneWay}"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}"
                                                  Width="14" Height="14"
                                                  Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xE895;" FontSize="13"
                                              Visibility="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.CheckUpdatesButtonText, Mode=OneWay}" FontSize="13" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.OpenGitHubCommand}"
                                    Padding="14,8"
                                    CornerRadius="8"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71B;" FontSize="13" />
                                    <TextBlock Text="{x:Bind ViewModel.GitHubRepoButtonText, Mode=OneWay}" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Update Status Message -->
                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                    <!-- Update Available Card -->
                    <Border Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="18,16"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                            BorderThickness="1.5">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="6" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.NewVersionTag, Mode=OneWay}"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Border Padding="6,1.5" CornerRadius="4" Background="#26FACC15" BorderBrush="#4DFACC15" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.UpdateSectionTitle, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.UpdateReleaseNotes, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.DownloadAndInstallUpdateCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanDownloadUpdate, Mode=OneWay}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        FontWeight="SemiBold"
                                        Padding="16,8"
                                        CornerRadius="8"
                                        VerticalAlignment="Center"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="13" />
                                        <TextBlock Text="{x:Bind ViewModel.DownloadUpdateButtonText, Mode=OneWay}" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Download Progress Bar -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ProgressBar Value="{x:Bind ViewModel.UpdateDownloadProgress, Mode=OneWay}"
                                             Maximum="100"
                                             Height="6"
                                             CornerRadius="3" />
                                <TextBlock Text="{x:Bind ViewModel.UpdateProgressText, Mode=OneWay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
