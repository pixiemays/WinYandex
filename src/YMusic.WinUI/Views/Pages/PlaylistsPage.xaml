<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!-- Busy Progress Ring -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Canvas.ZIndex="10" />

        <!-- 1. BROWSE VIEW (Library: Playlists & Liked Albums) -->
        <Grid x:Name="BrowseViewRoot"
              Padding="24,20,24,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BrowseTranslateTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with Title, Actions, and Category Selector Pills -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="14">
                <!-- Top Row: Page Title + Compact Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                               FontSize="26"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- Compact Actions: Create, Import & Refresh -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- Create Playlist Button -->
                        <Button Command="{x:Bind ViewModel.OpenCreatePlaylistDialogCommand}"
                                Height="34"
                                Padding="12,0"
                                CornerRadius="8"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CreatePlaylistTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.CreatePlaylistButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- Import from Spotify Button -->
                        <Button Command="{x:Bind ViewModel.OpenImportDialogCommand}"
                                Height="34"
                                Padding="12,0"
                                CornerRadius="8"
                                ToolTipService.ToolTip="{x:Bind ViewModel.ImportTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ImportButtonText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Sub Row: Category Selector Pills (Playlists vs Liked Albums) -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Playlists Tab Pill -->
                    <Button Click="CategoryPlaylists_Click"
                            Style="{StaticResource TabPillButtonStyle}"
                            Background="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE142;"
                                      FontSize="12"
                                      Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.PlaylistsTabText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.Playlists.Count, Mode=OneWay}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                        </StackPanel>
                    </Button>

                    <!-- Liked Albums Tab Pill -->
                    <Button Click="CategoryAlbums_Click"
                            Style="{StaticResource TabPillButtonStyle}"
                            Background="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;"
                                      FontSize="12"
                                      Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.LikedAlbumsTabText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.LikedAlbums.Count, Mode=OneWay}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- TAB 1: Playlists Grid -->
            <ScrollViewer Grid.Row="1"
                          x:Name="PlaylistsTabContent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="PlaylistsTabTranslateTransform" />
                </ScrollViewer.RenderTransform>
                <Grid>
                    <!-- Empty State -->
                    <StackPanel Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,60,0,0"
                                Visibility="{x:Bind ViewModel.Playlists.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE142;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoPlaylistsText, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Button Click="PlaylistCard_Click"
                                        Tag="{x:Bind}"
                                        Padding="0"
                                        Margin="0,0,18,18"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                            Click="TogglePlaylistLikeContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinMenuTextConverter}}"
                                                            Click="TogglePlaylistPinContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE840;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind PlayActionText, Mode=OneWay}"
                                                            Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="{x:Bind EditActionText, Mode=OneWay}"
                                                            Click="EditPlaylistContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind DeleteActionText, Mode=OneWay}"
                                                            Click="DeletePlaylistContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" Foreground="#FFFF5555" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Border Width="196"
                                            Padding="12"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid Width="172" Height="172">
                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="36"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>

                                                <!-- Pinned Badge Indicator -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Padding="6,3"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE840;" FontSize="10" Foreground="Black" />
                                                        <TextBlock Text="{x:Bind PinnedBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Pin Button Overlay -->
                                                <Button Click="PinPlaylist_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        CornerRadius="16"
                                                        Background="#99000000"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                                    <FontIcon Glyph="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                              FontSize="12"
                                                              Foreground="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                                </Button>

                                                <!-- Direct Play Button Overlay -->
                                                <Button Click="DirectPlayPlaylist_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        CornerRadius="20"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="Play playlist">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                </Button>
                                            </Grid>

                                            <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"
                                                           Height="32"
                                                           Visibility="{x:Bind Description, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind FormattedTrackCount}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- TAB 2: Liked Albums Grid -->
            <ScrollViewer Grid.Row="1"
                          x:Name="AlbumsTabContent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Opacity="0"
                          Visibility="Collapsed">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="AlbumsTabTranslateTransform" />
                </ScrollViewer.RenderTransform>
                <Grid>
                    <!-- Empty State -->
                    <StackPanel Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,60,0,0"
                                Visibility="{x:Bind ViewModel.LikedAlbums.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE93C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoLikedAlbumsText, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoLikedAlbumsSubtext, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Album Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LikedAlbums, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Button Click="AlbumCard_Click"
                                        Tag="{x:Bind}"
                                        Padding="0"
                                        Margin="0,0,18,18"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind LikeActionText, Mode=OneWay}"
                                                            Click="ToggleAlbumLikeContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinMenuTextConverter}}"
                                                            Click="ToggleAlbumPinContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE840;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind PlayActionText, Mode=OneWay}"
                                                            Click="DirectPlayAlbum_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Border Width="196"
                                            Padding="12"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid Width="172" Height="172">
                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="36"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>

                                                <!-- Badges Overlay (Pinned & Pre-save) -->
                                                <StackPanel HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Margin="8"
                                                            Spacing="4">
                                                    <!-- Pinned Badge Indicator -->
                                                    <Border Padding="6,3"
                                                            CornerRadius="10"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xE840;" FontSize="10" Foreground="Black" />
                                                            <TextBlock Text="{x:Bind PinnedBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Pre-save Badge Indicator -->
                                                    <Border Padding="6,3"
                                                            CornerRadius="6"
                                                            Background="#D01E1B2E"
                                                            BorderBrush="#458B5CF6"
                                                            BorderThickness="1"
                                                            Visibility="{x:Bind IsPreSave, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <FontIcon Glyph="&#xEA8F;" FontSize="10" Foreground="#C4B5FD" />
                                                            <TextBlock Text="{x:Bind PreSaveBadgeText, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#C4B5FD" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Pin Button Overlay -->
                                                <Button Click="PinAlbum_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        CornerRadius="16"
                                                        Background="#99000000"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                                    <FontIcon Glyph="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                              FontSize="12"
                                                              Foreground="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                                </Button>

                                                <!-- Direct Action Button Overlay (Play or Pre-save) -->
                                                <Button Click="DirectPlayAlbum_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        CornerRadius="20"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind ActionTooltip, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind ActionGlyph, Mode=OneWay}" FontSize="14" Margin="1,0,0,0" />
                                                </Button>
                                            </Grid>

                                            <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind ArtistNames}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind FormattedReleaseDate, Mode=OneWay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                           FontWeight="SemiBold"
                                                           Visibility="{x:Bind IsPreSave, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind FormattedYearAndTracks}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           Visibility="{x:Bind IsPreSave, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 2. DETAIL VIEW (Full-width Playlist or Album tracks) -->
        <Grid x:Name="DetailViewRoot"
              Padding="24,16,24,0"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetailTranslateTransform" Y="28" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0"
                    Click="DetailBackButton_Click"
                    Margin="0,0,0,10"
                    Height="34"
                    CornerRadius="17"
                    Padding="14,0"
                    helpers:CursorHelper.UseHandCursor="True"
                    Visibility="{x:Bind ViewModel.IsBackButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.BackButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!-- Track List (Full Width!) -->
            <controls:ObservableListView x:Name="TracksListView"
                                         Grid.Row="1"
                                         Padding="0,0,0,24"
                                         ItemsSource="{x:Bind ViewModel.SelectedPlaylistTracks, Mode=OneWay}"
                                         IsItemClickEnabled="True"
                                         ItemClick="TrackListView_ItemClick"
                                         SelectionMode="None">
                <controls:ObservableListView.Header>
                    <StackPanel Spacing="6">
                        <!-- Hero Header (Scrolls naturally with tracks!) -->
                        <Grid x:Name="PlaylistHeroGrid"
                              Margin="0,0,0,12"
                              Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cover Artwork -->
                        <Border x:Name="PlaylistCoverBorder"
                                Grid.Column="0"
                                Width="140"
                                Height="140"
                                CornerRadius="10"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <FontIcon x:Name="PlaylistCoverIcon"
                                          Glyph="&#xE8D6;"
                                          FontSize="36"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.DetailCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Meta Details -->
                        <StackPanel x:Name="PlaylistMetaStack"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0"
                                    Spacing="8">
                            <!-- Type Badge -->
                            <Border HorizontalAlignment="Left"
                                    Background="{x:Bind ViewModel.IsDetailPreSave, Mode=OneWay, Converter={StaticResource BoolToPreSaveBadgeBackgroundConverter}}"
                                    BorderBrush="{x:Bind ViewModel.IsDetailPreSave, Mode=OneWay, Converter={StaticResource BoolToPreSaveBadgeBorderConverter}}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2">
                                <TextBlock Text="{x:Bind ViewModel.DetailTypeBadge, Mode=OneWay}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.IsDetailPreSave, Mode=OneWay, Converter={StaticResource BoolToPreSaveBadgeForegroundConverter}}" />
                            </Border>

                            <TextBlock x:Name="PlaylistTitleText"
                                       Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />

                            <StackPanel x:Name="PlaylistExtraInfoPanel" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"
                                           Visibility="{x:Bind ViewModel.DetailDescription, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            Visibility="{x:Bind ViewModel.HasTrackCountOrDuration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.FormattedTrackCount, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind ViewModel.HasFormattedDuration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind ViewModel.HasFormattedDuration, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Actions Row + Search Filter -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button Command="{x:Bind ViewModel.PlayCurrentCollectionCommand}"
                                            Style="{ThemeResource AccentButtonStyle}"
                                            Height="40"
                                            Padding="20,0"
                                            CornerRadius="20"
                                            helpers:CursorHelper.UseHandCursor="True">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind ViewModel.DetailPlayButtonGlyph, Mode=OneWay}" FontSize="13" />
                                            <TextBlock Text="{x:Bind ViewModel.DetailPlayButtonText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Like / Favorite Button (Icon only) -->
                                    <Button Command="{x:Bind ViewModel.ToggleCurrentDetailLikeCommand}"
                                            Height="40"
                                            Width="40"
                                            Padding="0"
                                            CornerRadius="20"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Visibility="{x:Bind ViewModel.IsDetailLikeButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeTooltipConverter}}">
                                        <FontIcon Glyph="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                  FontSize="14"
                                                  Foreground="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                    </Button>

                                    <!-- Pin Button (Icon only) -->
                                    <Button Command="{x:Bind ViewModel.ToggleCurrentDetailPinCommand}"
                                            Height="40"
                                            Width="40"
                                            Padding="0"
                                            CornerRadius="20"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                        <FontIcon Glyph="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                  FontSize="14"
                                                  Foreground="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                    </Button>

                                    <!-- Edit Playlist Button (only if owned playlist, Icon only) -->
                                    <Button Command="{x:Bind ViewModel.OpenEditPlaylistDialogCommand}"
                                            Height="40"
                                            Width="40"
                                            Padding="0"
                                            CornerRadius="20"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Visibility="{x:Bind ViewModel.IsSelectedPlaylistOwned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.EditPlaylistButtonText, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                    </Button>

                                    <!-- Delete Playlist Button (if playlist, Icon only) -->
                                    <Button Command="{x:Bind ViewModel.OpenDeletePlaylistDialogCommand}"
                                            Height="40"
                                            Width="40"
                                            Padding="0"
                                            CornerRadius="20"
                                            helpers:CursorHelper.UseHandCursor="True"
                                            Visibility="{x:Bind ViewModel.IsDetailPlaylist, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.DeletePlaylistButtonText, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#FFFF5555" />
                                    </Button>
                                </StackPanel>

                                <!-- In-Playlist Search Filter Box -->
                                <AutoSuggestBox Grid.Column="1"
                                                Width="220"
                                                Height="40"
                                                CornerRadius="20"
                                                HorizontalAlignment="Right"
                                                Margin="16,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.HasTracksToFilter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                PlaceholderText="{x:Bind ViewModel.FilterPlaceholder, Mode=OneWay}"
                                                QueryIcon="Find"
                                                Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Pre-Save Hero Announcement Card -->
                    <Border Visibility="{x:Bind ViewModel.IsDetailPreSave, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16,14"
                            Margin="0,0,0,12">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Icon badge -->
                            <Border Grid.Column="0"
                                    Width="38"
                                    Height="38"
                                    CornerRadius="19"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xEA8F;" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Text info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.PreSaveBannerTitle, Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <Border Background="#268B5CF6"
                                            BorderBrush="#408B5CF6"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.SelectedAlbum.FormattedReleaseDate, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedAlbum.FormattedReleaseDate, Mode=OneWay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#C4B5FD" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.PreSaveBannerDescription, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </controls:ObservableListView.Header>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackRowListViewItemStyle}" />
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border CornerRadius="8"
                                Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                Opacity="{x:Bind TrackOpacity, Mode=OneWay}"
                                helpers:TrackMenuHelper.Track="{x:Bind}"
                                Margin="0">
                            <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <!-- Accent Indicator Bar -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           Height="18"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Margin="0,0,6,0"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="6"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind ThumbnailUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                        <!-- Equalizer Overlay -->
                                        <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Background="#B3000000"
                                              CornerRadius="6">
                                            <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MaxWidth="360" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind FullTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <Border Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsCached, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Saved in offline cache (0 ms)">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE896;" FontSize="8" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="CACHED" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind Available, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind UnavailableTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE787;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <TextBlock Text="{x:Bind UnavailableBadgeText, Mode=OneWay}" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="4"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsAiTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="#26EF4444"
                                                BorderBrush="#80EF4444"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind AiTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE99A;" FontSize="8" Foreground="#FFEF4444" />
                                                <TextBlock Text="{x:Bind AiBadgeLabel, Mode=OneWay}" FontSize="8" FontWeight="Bold" Foreground="#FFEF4444" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <HyperlinkButton Click="TrackArtist_Click"
                                                     Tag="{x:Bind}"
                                                     Padding="0"
                                                     Margin="0,2,0,0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{x:Bind ArtistNames}">
                                        <TextBlock Text="{x:Bind ArtistNames}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsHitTestVisible="False" />
                                    </HyperlinkButton>
                                </StackPanel>

                                <!-- Album (Clickable) -->
                                <HyperlinkButton Grid.Column="3"
                                                 Click="TrackAlbum_Click"
                                                 Tag="{x:Bind}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                    <TextBlock Text="{x:Bind AlbumTitle, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>

                                <!-- Duration -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Like Button -->
                                <Button Grid.Column="5"
                                        Click="TrackLikeButton_Click"
                                        Tag="{x:Bind}"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="17"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                              FontSize="15"
                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </controls:ObservableListView>
        </Grid>

        <!-- Spotify Import Modal Dialog Overlay -->
        <Grid Background="#99000000"
              Canvas.ZIndex="50"
              Visibility="{x:Bind ViewModel.IsImportDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="520"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE898;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ImportDialogTitle, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CloseImportDialogCommand}"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.IsNotImporting, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Input state (when not finished) -->
                    <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsImportFinished, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                        <TextBox Header="Ссылка на Spotify"
                                 Text="{x:Bind ViewModel.ImportUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind ViewModel.ImportUrlPlaceholder, Mode=OneWay}"
                                 IsEnabled="{x:Bind ViewModel.IsNotImporting, Mode=OneWay}" />

                        <TextBox Header="Название в Яндекс Музыке (необязательно)"
                                 Text="{x:Bind ViewModel.ImportCustomTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind ViewModel.ImportCustomTitlePlaceholder, Mode=OneWay}"
                                 IsEnabled="{x:Bind ViewModel.IsNotImporting, Mode=OneWay}" />

                        <!-- Progress Bar during import -->
                        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressBar Value="{x:Bind ViewModel.ImportProgressValue, Mode=OneWay}" Maximum="100" />
                            <TextBlock Text="{x:Bind ViewModel.ImportStatusText, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Error or idle status message -->
                        <TextBlock Text="{x:Bind ViewModel.ImportStatusText, Mode=OneWay}"
                                   FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />

                        <!-- Action Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Button Content="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CloseImportDialogCommand}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{x:Bind ViewModel.IsNotImporting, Mode=OneWay}" />

                            <Button Content="{x:Bind ViewModel.StartImportButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.StartImportCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{x:Bind ViewModel.IsNotImporting, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Success / Finished State -->
                    <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsImportFinished, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ImportResultSummary, Mode=OneWay}"
                                       FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Button Content="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.CloseImportDialogCommand}"
                                    HorizontalAlignment="Left" />

                            <Button Content="{x:Bind ViewModel.OpenImportedPlaylistButtonText, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.OpenImportedPlaylistCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. MODAL OVERLAY: Create Playlist Dialog -->
        <Grid Background="#80000000"
              Canvas.ZIndex="50"
              Visibility="{x:Bind ViewModel.IsCreatePlaylistDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="480"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CreatePlaylistHeader, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CloseCreatePlaylistDialogCommand}"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBox Header="Название плейлиста"
                             Text="{x:Bind ViewModel.NewPlaylistTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind ViewModel.PlaylistTitlePlaceholder, Mode=OneWay}"
                             IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}" />

                    <TextBox Header="Описание (необязательно)"
                             Text="{x:Bind ViewModel.NewPlaylistDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind ViewModel.PlaylistDescPlaceholder, Mode=OneWay}"
                             AcceptsReturn="True"
                             Height="72"
                             IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}" />

                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsNewPlaylistPublic, Mode=TwoWay}"
                                  OnContent="{x:Bind ViewModel.PlaylistPublicToggleText, Mode=OneWay}"
                                  OffContent="Приватный плейлист"
                                  IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}" />

                    <!-- Error message if any -->
                    <TextBlock Text="{x:Bind ViewModel.CreatePlaylistErrorMessage, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.CreatePlaylistErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Button Content="{x:Bind ViewModel.CancelButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CloseCreatePlaylistDialogCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}" />

                        <Button Content="{x:Bind ViewModel.CreateButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CreatePlaylistCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                IsEnabled="{x:Bind ViewModel.IsNotCreatingPlaylist, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 5. MODAL OVERLAY: Edit Playlist Dialog -->
        <Grid Background="#80000000"
              Canvas.ZIndex="50"
              Visibility="{x:Bind ViewModel.IsEditPlaylistDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="480"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE70F;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EditPlaylistHeader, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CloseEditPlaylistDialogCommand}"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.IsNotEditingPlaylist, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <TextBox Header="Название плейлиста"
                             Text="{x:Bind ViewModel.EditPlaylistTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind ViewModel.PlaylistTitlePlaceholder, Mode=OneWay}"
                             IsEnabled="{x:Bind ViewModel.IsNotEditingPlaylist, Mode=OneWay}" />

                    <TextBox Header="Описание"
                             Text="{x:Bind ViewModel.EditPlaylistDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind ViewModel.PlaylistDescPlaceholder, Mode=OneWay}"
                             AcceptsReturn="True"
                             Height="72"
                             IsEnabled="{x:Bind ViewModel.IsNotEditingPlaylist, Mode=OneWay}" />

                    <!-- Error message if any -->
                    <TextBlock Text="{x:Bind ViewModel.EditPlaylistErrorMessage, Mode=OneWay}"
                               FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.EditPlaylistErrorMessage, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Button Content="{x:Bind ViewModel.CancelButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CloseEditPlaylistDialogCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsNotEditingPlaylist, Mode=OneWay}" />

                        <Button Content="{x:Bind ViewModel.SaveButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SaveEditPlaylistCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Right"
                                IsEnabled="{x:Bind ViewModel.IsNotEditingPlaylist, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 6. MODAL OVERLAY: Delete Playlist Confirmation Dialog -->
        <Grid Background="#80000000"
              Canvas.ZIndex="50"
              Visibility="{x:Bind ViewModel.IsDeletePlaylistDialogOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="440"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <StackPanel Spacing="18">
                    <!-- Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74D;" FontSize="20" Foreground="#FFFF5555" />
                            <TextBlock Text="{x:Bind ViewModel.DeletePlaylistHeader, Mode=OneWay}"
                                       FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                Command="{x:Bind ViewModel.CloseDeletePlaylistDialogCommand}"
                                Padding="8"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{x:Bind ViewModel.IsNotDeletingPlaylist, Mode=OneWay}">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <!-- Prompt Text -->
                    <TextBlock Text="{x:Bind ViewModel.DeletePlaylistPromptText, Mode=OneWay}"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Button Content="{x:Bind ViewModel.CancelButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.CloseDeletePlaylistDialogCommand}"
                                HorizontalAlignment="Left"
                                IsEnabled="{x:Bind ViewModel.IsNotDeletingPlaylist, Mode=OneWay}" />

                        <Button Content="{x:Bind ViewModel.DeleteButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.ConfirmDeletePlaylistCommand}"
                                Background="#E81123"
                                Foreground="White"
                                HorizontalAlignment="Right"
                                IsEnabled="{x:Bind ViewModel.IsNotDeletingPlaylist, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
