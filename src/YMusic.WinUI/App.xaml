<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="YMusic.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:YMusic.WinUI"
    xmlns:converters="using:YMusic.WinUI.Converters"
    xmlns:helpers="using:YMusic.WinUI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2CFFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#30FFFFFF" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#34FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#10000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#18000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#20000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#25000000" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#2A000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter.ttf#Inter</FontFamily>
            
            <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
            <converters:BoolToAccentBrushConverter x:Key="BoolToAccentBrushConverter" />
            <converters:RepeatToAccentBrushConverter x:Key="RepeatToAccentBrushConverter" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Invert="True" />
            <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
            <converters:BoolToLikeBrushConverter x:Key="BoolToLikeBrushConverter" />
            <converters:BoolToLikeGlyphConverter x:Key="BoolToLikeGlyphConverter" />
            <converters:BoolToLikeButtonTextConverter x:Key="BoolToLikeButtonTextConverter" />
            <converters:BoolToLikeTooltipConverter x:Key="BoolToLikeTooltipConverter" />
            <converters:BoolToLikeMenuTextConverter x:Key="BoolToLikeMenuTextConverter" />
            <converters:BoolToTrackTitleBrushConverter x:Key="BoolToTrackTitleBrushConverter" />
            <converters:BoolToTrackHighlightBrushConverter x:Key="BoolToTrackHighlightBrushConverter" />
            <converters:BoolToPillBackgroundConverter x:Key="BoolToPillBackgroundConverter" />
            <converters:BoolToPillForegroundConverter x:Key="BoolToPillForegroundConverter" />
            <converters:BoolToPinGlyphConverter x:Key="BoolToPinGlyphConverter" />
            <converters:BoolToPinTooltipConverter x:Key="BoolToPinTooltipConverter" />
            <converters:BoolToPinButtonTextConverter x:Key="BoolToPinButtonTextConverter" />
            <converters:BoolToPinMenuTextConverter x:Key="BoolToPinMenuTextConverter" />
            <converters:BoolToPinForegroundBrushConverter x:Key="BoolToPinForegroundBrushConverter" />
            <converters:BoolToSubtleHighlightBrushConverter x:Key="BoolToSubtleHighlightBrushConverter" />
            <converters:ActiveLyricToForegroundConverter x:Key="ActiveLyricToForegroundConverter" />
            <converters:BoolToPreSaveBadgeBackgroundConverter x:Key="BoolToPreSaveBadgeBackgroundConverter" />
            <converters:BoolToPreSaveBadgeForegroundConverter x:Key="BoolToPreSaveBadgeForegroundConverter" />
            <converters:BoolToPreSaveBadgeBorderConverter x:Key="BoolToPreSaveBadgeBorderConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:BoolToSegmentBackgroundConverter x:Key="BoolToSegmentBackgroundConverter" />
            <converters:BoolToPresetBorderBrushConverter x:Key="BoolToPresetBorderBrushConverter" />
            <converters:BoolToPresetBackgroundBrushConverter x:Key="BoolToPresetBackgroundBrushConverter" />

            <Style x:Key="TabPillButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="White"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.12" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.20" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsSegmentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="Center"
                                                  VerticalContentAlignment="Center" />
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="White"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.10" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.18" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Track Row ListViewItem Container Style with translucent Fluent 2 hover and selection -->
            <Style x:Key="TrackRowListViewItemStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
            </Style>

            <!-- Track Row Button Style with translucent Fluent 2 hover overlay -->
            <Style x:Key="TrackRowButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Background="{TemplateBinding Background}"
                                                  BorderBrush="{TemplateBinding BorderBrush}"
                                                  BorderThickness="{TemplateBinding BorderThickness}"
                                                  CornerRadius="{TemplateBinding CornerRadius}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Background="White"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.08" Duration="0:0:0.1" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.14" Duration="0:0:0.05" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button">
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
            </Style>
            <Style TargetType="HyperlinkButton">
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="helpers:CursorHelper.UseHandCursor" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
