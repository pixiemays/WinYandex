<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!-- Busy Progress Ring -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="40"
                      Height="40"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Canvas.ZIndex="10" />

        <!-- 1. BROWSE VIEW (Library: Playlists & Liked Albums) -->
        <Grid x:Name="BrowseViewRoot"
              Padding="20,18,20,16">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BrowseTranslateTransform" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header with Category Selector Pills -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Title -->
                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}"
                           FontSize="28"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0" />

                <!-- Category Pills (Playlists vs Liked Albums) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <!-- Playlists Tab Pill -->
                    <Button Click="CategoryPlaylists_Click"
                            Padding="16,7"
                            CornerRadius="18"
                            Background="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE142;"
                                      FontSize="13"
                                      Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.PlaylistsTabText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.Playlists.Count, Mode=OneWay}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       Foreground="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                        </StackPanel>
                    </Button>

                    <!-- Liked Albums Tab Pill -->
                    <Button Click="CategoryAlbums_Click"
                            Padding="16,7"
                            CornerRadius="18"
                            Background="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE93C;"
                                      FontSize="13"
                                      Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.LikedAlbumsTabText, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.LikedAlbums.Count, Mode=OneWay}"
                                       FontSize="11"
                                       Opacity="0.8"
                                       Foreground="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.LoadPlaylistsCommand}"
                        Height="36"
                        ToolTipService.ToolTip="{x:Bind ViewModel.RefreshTooltip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- TAB 1: Playlists Grid -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind ViewModel.IsPlaylistsTab, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,60,0,0"
                                Visibility="{x:Bind ViewModel.Playlists.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE142;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoPlaylistsText, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Button Click="PlaylistCard_Click"
                                        Tag="{x:Bind}"
                                        Padding="0"
                                        Margin="0,0,18,18"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                            Click="TogglePlaylistLikeContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinMenuTextConverter}}"
                                                            Click="TogglePlaylistPinContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE840;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind PlayActionText, Mode=OneWay}"
                                                            Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Border Width="196"
                                            Padding="12"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid Width="172" Height="172">
                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="36"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>

                                                <!-- Pinned Badge Indicator -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Padding="6,3"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE840;" FontSize="10" Foreground="Black" />
                                                        <TextBlock Text="{x:Bind PinnedBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Pin Button Overlay -->
                                                <Button Click="PinPlaylist_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        CornerRadius="16"
                                                        Background="#99000000"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                                    <FontIcon Glyph="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                              FontSize="12"
                                                              Foreground="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                                </Button>

                                                <!-- Direct Play Button Overlay -->
                                                <Button Click="DirectPlayPlaylist_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        CornerRadius="20"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="Play playlist">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                </Button>
                                            </Grid>

                                            <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind Description}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="2"
                                                           Height="32"
                                                           Visibility="{x:Bind Description, Converter={StaticResource NotNullToVisibilityConverter}}" />
                                                <TextBlock Text="{x:Bind FormattedTrackCount}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- TAB 2: Liked Albums Grid -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{x:Bind ViewModel.IsAlbumsTab, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel Spacing="12"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,60,0,0"
                                Visibility="{x:Bind ViewModel.LikedAlbums.Count, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE93C;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoLikedAlbumsText, Mode=OneWay}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoLikedAlbumsSubtext, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Album Cards -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LikedAlbums, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Button Click="AlbumCard_Click"
                                        Tag="{x:Bind}"
                                        Padding="0"
                                        Margin="0,0,18,18"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <Button.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                            Click="ToggleAlbumLikeContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinMenuTextConverter}}"
                                                            Click="ToggleAlbumPinContext_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE840;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="{x:Bind PlayActionText, Mode=OneWay}"
                                                            Click="DirectPlayAlbum_Click"
                                                            Tag="{x:Bind}">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE768;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.ContextFlyout>
                                    <Border Width="196"
                                            Padding="12"
                                            CornerRadius="12"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid Width="172" Height="172">
                                                <Border CornerRadius="8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8D6;"
                                                                  FontSize="36"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>

                                                <!-- Pinned Badge Indicator -->
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Padding="6,3"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE840;" FontSize="10" Foreground="Black" />
                                                        <TextBlock Text="{x:Bind PinnedBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="Black" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Pin Button Overlay -->
                                                <Button Click="PinAlbum_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="8"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0"
                                                        CornerRadius="16"
                                                        Background="#99000000"
                                                        BorderThickness="0"
                                                        ToolTipService.ToolTip="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                                    <FontIcon Glyph="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                              FontSize="12"
                                                              Foreground="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                                </Button>

                                                <!-- Direct Play Button Overlay -->
                                                <Button Click="DirectPlayAlbum_Click"
                                                        Tag="{x:Bind}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="8"
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        CornerRadius="20"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        ToolTipService.ToolTip="Play album">
                                                    <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                </Button>
                                            </Grid>

                                            <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind ArtistNames}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind FormattedYearAndTracks}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- 2. DETAIL VIEW (Full-width Playlist or Album tracks) -->
        <Grid x:Name="DetailViewRoot"
              Padding="18,14,18,14"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetailTranslateTransform" Y="28" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Back Button -->
            <Button Grid.Row="0"
                    Click="DetailBackButton_Click"
                    Margin="0,0,0,16"
                    Height="34"
                    Visibility="{x:Bind ViewModel.IsBackButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.BackButtonText, Mode=OneWay}" />
                </StackPanel>
            </Button>

            <!-- Hero Header (Collapsible on scroll) -->
            <Grid x:Name="PlaylistHeroGrid"
                  Grid.Row="1"
                  Margin="0,0,0,24"
                  Background="Transparent"
                  PointerWheelChanged="PlaylistHeroGrid_PointerWheelChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cover Artwork -->
                <Border x:Name="PlaylistCoverBorder"
                        Grid.Column="0"
                        Width="140"
                        Height="140"
                        CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <FontIcon x:Name="PlaylistCoverIcon"
                                  Glyph="&#xE8D6;"
                                  FontSize="36"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.DetailCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <!-- Meta Details -->
                <StackPanel x:Name="PlaylistMetaStack"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0"
                            Spacing="8">
                    <!-- Type Badge -->
                    <Border HorizontalAlignment="Left"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="8,2">
                        <TextBlock Text="{x:Bind ViewModel.DetailTypeBadge, Mode=OneWay}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <TextBlock x:Name="PlaylistTitleText"
                               Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                               FontSize="28"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2" />

                    <StackPanel x:Name="PlaylistExtraInfoPanel" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                                   FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxLines="2"
                                   Visibility="{x:Bind ViewModel.DetailDescription, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.FormattedTrackCount, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button Command="{x:Bind ViewModel.PlayCurrentCollectionCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                Height="36"
                                Padding="18,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="13" />
                                <TextBlock Text="{x:Bind ViewModel.DetailPlayButtonText, Mode=OneWay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleCurrentDetailLikeCommand}"
                                Height="36"
                                Padding="14,0"
                                ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeTooltipConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                          FontSize="13"
                                          Foreground="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeButtonTextConverter}}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleCurrentDetailPinCommand}"
                                Height="36"
                                Padding="14,0"
                                ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                          FontSize="13"
                                          Foreground="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                <TextBlock Text="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinButtonTextConverter}}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Track List (Full Width!) -->
            <controls:ObservableListView x:Name="TracksListView"
                                         Grid.Row="2"
                                         ItemsSource="{x:Bind ViewModel.SelectedPlaylistTracks, Mode=OneWay}"
                                         IsItemClickEnabled="True"
                                         ItemClick="TrackListView_ItemClick"
                                         SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border CornerRadius="8"
                                Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                Margin="0">
                            <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <!-- Accent Indicator Bar -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           Height="18"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Margin="0,0,6,0"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                        <!-- Equalizer Overlay -->
                                        <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Background="#A6000000"
                                              CornerRadius="4">
                                            <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MaxWidth="360" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind FullTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <Border Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsCached, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Saved in offline cache (0 ms)">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE896;" FontSize="8" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="CACHED" FontSize="8" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <HyperlinkButton Click="TrackArtist_Click"
                                                     Tag="{x:Bind}"
                                                     Padding="0"
                                                     Margin="0,2,0,0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{x:Bind ArtistNames}">
                                        <TextBlock Text="{x:Bind ArtistNames}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsHitTestVisible="False" />
                                    </HyperlinkButton>
                                </StackPanel>

                                <!-- Album (Clickable) -->
                                <HyperlinkButton Grid.Column="3"
                                                 Click="TrackAlbum_Click"
                                                 Tag="{x:Bind}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                    <TextBlock Text="{x:Bind AlbumTitle}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>

                                <!-- Duration -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind FormattedDuration}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Like Button -->
                                <Button Grid.Column="5"
                                        Click="TrackLikeButton_Click"
                                        Tag="{x:Bind}"
                                        Width="34"
                                        Height="34"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="17"
                                        Background="Transparent"
                                        BorderBrush="Transparent">
                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                              FontSize="15"
                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </controls:ObservableListView>
        </Grid>
    </Grid>
</Page>
