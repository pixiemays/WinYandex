<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    mc:Ignorable="d">

    <Grid>
        <!-- Busy Progress Indicator -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="44"
                      Height="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Canvas.ZIndex="10" />

        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,18,24,32">
            <StackPanel Spacing="28" MaxWidth="1400" HorizontalAlignment="Stretch">

                <!-- 1. NAVIGATION BAR / BACK BUTTON -->
                <Button Click="BackButton_Click"
                        Height="34"
                        Padding="14,0"
                        CornerRadius="17"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        helpers:CursorHelper.UseHandCursor="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.BackButtonText, Mode=OneWay}" FontSize="13" />
                    </StackPanel>
                </Button>

                <!-- 2. HERO HEADER (Avatar, Name, Listeners, Action Buttons) -->
                <Border CornerRadius="18"
                        Padding="28"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid ColumnSpacing="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Circular Avatar -->
                        <Border Grid.Column="0"
                                Width="160"
                                Height="160"
                                CornerRadius="80"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="2"
                                VerticalAlignment="Center">
                            <Grid>
                                <FontIcon Glyph="&#xE77B;" FontSize="54" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind ViewModel.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                       Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <!-- Artist Info & Actions -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                            <!-- Badge -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="ИСПОЛНИТЕЛЬ"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Artist Name -->
                            <TextBlock Text="{x:Bind ViewModel.ArtistName, Mode=OneWay}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />

                            <!-- Monthly Listeners & Genres -->
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.FormattedListeners, Mode=OneWay}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                           Visibility="{x:Bind ViewModel.FormattedListeners, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                                <TextBlock Text="{x:Bind ViewModel.FormattedGenres, Mode=OneWay}"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind ViewModel.FormattedGenres, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Action Row (Play All & Like) -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                <!-- Listen / Play All Popular Tracks -->
                                <Button Command="{x:Bind ViewModel.PlayPopularTracksCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Height="42"
                                        Padding="22,0"
                                        CornerRadius="21"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Слушать" FontWeight="SemiBold" FontSize="14" />
                                    </StackPanel>
                                </Button>

                                <!-- Like / Favorite Artist -->
                                <Button Command="{x:Bind ViewModel.ToggleLikeArtistCommand}"
                                        Height="42"
                                        Width="42"
                                        Padding="0"
                                        CornerRadius="21"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Добавить в любимые исполнители"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <FontIcon Glyph="{x:Bind ViewModel.IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. POPULAR TRACKS SECTION -->
                <StackPanel Spacing="14"
                            Visibility="{x:Bind ViewModel.HasPopularTracks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Популярные треки"
                               FontSize="20"
                               FontWeight="Bold" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.PopularTracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button Click="TrackRow_Click"
                                        Tag="{x:Bind}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="12,8"
                                        Margin="0,2"
                                        CornerRadius="10"
                                        Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                        BorderBrush="Transparent"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <Grid Height="44" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <!-- Track Cover & Equalizer -->
                                            <ColumnDefinition Width="44" />
                                            <!-- Title & Subtitle -->
                                            <ColumnDefinition Width="*" />
                                            <!-- Like Button -->
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Duration -->
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Artwork with Play / Equalizer Overlay -->
                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Stretch="UniformToFill" />
                                                <!-- Mini Equalizer Overlay when Playing -->
                                                <Border Background="#66000000"
                                                        CornerRadius="8"
                                                        Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Track Title & Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind FullTitle, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                            <TextBlock Text="{x:Bind ArtistNames, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                        </StackPanel>

                                        <!-- Like Button -->
                                        <Button Grid.Column="2"
                                                Click="TrackLikeButton_Click"
                                                Tag="{x:Bind}"
                                                Width="36"
                                                Height="36"
                                                Padding="0"
                                                CornerRadius="18"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                helpers:CursorHelper.UseHandCursor="True">
                                            <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                      FontSize="14"
                                                      Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                        </Button>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,4,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 4. DISCOGRAPHY / ALBUMS SECTION -->
                <StackPanel Spacing="16"
                            Visibility="{x:Bind ViewModel.HasAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Section Header with Filter Pills & Sort Button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Дискография"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,24,0" />

                        <!-- Filter Chips: All, Albums, Singles & EPs, Compilations -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Click="FilterChip_Click" Tag="0"
                                    Padding="14,6" CornerRadius="16"
                                    Background="{x:Bind ViewModel.IsAllReleasesFilter, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                                    BorderThickness="0"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <TextBlock Text="Все релизы"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.IsAllReleasesFilter, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            </Button>

                            <Button Click="FilterChip_Click" Tag="1"
                                    Padding="14,6" CornerRadius="16"
                                    Background="{x:Bind ViewModel.IsAlbumsFilter, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                                    BorderThickness="0"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <TextBlock Text="Альбомы"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.IsAlbumsFilter, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            </Button>

                            <Button Click="FilterChip_Click" Tag="2"
                                    Padding="14,6" CornerRadius="16"
                                    Background="{x:Bind ViewModel.IsSinglesFilter, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                                    BorderThickness="0"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <TextBlock Text="Синглы и EP"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.IsSinglesFilter, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            </Button>

                            <Button Click="FilterChip_Click" Tag="3"
                                    Padding="14,6" CornerRadius="16"
                                    Background="{x:Bind ViewModel.IsCompilationsFilter, Mode=OneWay, Converter={StaticResource BoolToPillBackgroundConverter}}"
                                    BorderThickness="0"
                                    Visibility="{x:Bind ViewModel.HasAlsoAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    helpers:CursorHelper.UseHandCursor="True">
                                <TextBlock Text="Сборники"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind ViewModel.IsCompilationsFilter, Mode=OneWay, Converter={StaticResource BoolToPillForegroundConverter}}" />
                            </Button>
                        </StackPanel>

                        <!-- Sort Toggle Button: Сначала новые / Сначала старые -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                                Height="34"
                                Padding="14,0"
                                CornerRadius="17"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ToolTipService.ToolTip="Изменить порядок сортировки (по году)"
                                helpers:CursorHelper.UseHandCursor="True">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.SortOrderGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SortOrderText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Albums Empty In Selected Filter Placeholder -->
                    <TextBlock Text="В этой категории пока нет релизов"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="4,8"
                               Visibility="{x:Bind ViewModel.HasDisplayAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=invert}" />

                    <!-- Albums Wrap Grid -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayAlbums, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasDisplayAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="195" ItemHeight="265" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Album">
                                <Button Click="AlbumCard_Click"
                                        Tag="{x:Bind}"
                                        Margin="6"
                                        Padding="14"
                                        CornerRadius="14"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        helpers:CursorHelper.UseHandCursor="True">
                                    <StackPanel Spacing="10">
                                        <Border Width="167" Height="167" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <Grid>
                                                <Image Source="{x:Bind CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                <Border Background="#20000000" CornerRadius="10" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{x:Bind Year, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind FormattedTrackCount, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 5. ABOUT / BIO SECTION -->
                <StackPanel Spacing="14"
                            Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Об исполнителе"
                               FontSize="20"
                               FontWeight="Bold" />

                    <Border CornerRadius="14"
                            Padding="22"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.DescriptionText, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 6. EMPTY STATE (if artist has no tracks/albums) -->
                <StackPanel Spacing="12"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Padding="0,48"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE142;" FontSize="26" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="У этого исполнителя пока нет доступных треков или альбомов"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
