<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.ExplorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <!-- Loading overlay -->
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      Width="44"
                      Height="44"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Canvas.ZIndex="10" />

        <!-- Error InfoBar -->
        <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 Severity="Error"
                 Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                 VerticalAlignment="Top"
                 Margin="32,16"
                 Canvas.ZIndex="20" />

        <!-- 1. MAIN BROWSE VIEW -->
        <ScrollViewer x:Name="BrowseViewRoot"
                      Padding="32,24,32,24">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="BrowseTranslateTransform" />
            </ScrollViewer.RenderTransform>
            <StackPanel Spacing="28">
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- SECTION 0: HERO МОЯ ВОЛНА -->
                <Border Visibility="{x:Bind ViewModel.ShowWave, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        CornerRadius="16"
                        Padding="24"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Identity + Controls -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Wave Identity & Status -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <Border Width="56" Height="56"
                                        CornerRadius="28"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <FontIcon Glyph="{x:Bind ViewModel.Wave.SelectedPreset.Glyph, Mode=OneWay}"
                                              FontSize="26"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>

                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.Wave.WaveTitleText, Mode=OneWay}"
                                                   FontSize="22"
                                                   FontWeight="Bold" />
                                        <Border Visibility="{x:Bind ViewModel.Wave.IsWavePlaying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <controls:MiniEqualizerControl IsPlaying="{x:Bind ViewModel.Wave.IsPlaying, Mode=OneWay}" Width="10" Height="10" />
                                                <TextBlock Text="{x:Bind ViewModel.WaveOnAirBadgeText, Mode=OneWay}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{x:Bind ViewModel.WaveSubtitleDisplay, Mode=OneWay}"
                                               FontSize="13"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="580" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Playback controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Like button -->
                                <Button Command="{x:Bind ViewModel.Wave.ToggleLikeCommand}"
                                        Width="40" Height="40"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="20"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Wave.LikeTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.Wave.LikeGlyph, Mode=OneWay}"
                                              FontSize="16"
                                              Foreground="{x:Bind ViewModel.Wave.IsCurrentTrackLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                </Button>

                                <!-- Dislike button -->
                                <Button Command="{x:Bind ViewModel.Wave.SendDislikeAndSkipCommand}"
                                        Width="40" Height="40"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="20"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Wave.DislikeTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE1E0;" FontSize="15" />
                                </Button>

                                <!-- Next Track button -->
                                <Button Command="{x:Bind ViewModel.Wave.NextWaveTrackCommand}"
                                        Width="40" Height="40"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="20"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Wave.NextTrackTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                                </Button>

                                <!-- Large Play/Pause button -->
                                <Button Command="{x:Bind ViewModel.Wave.TogglePlayPauseCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Width="52" Height="52"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="26"
                                        helpers:CursorHelper.UseHandCursor="True"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.Wave.PlayPauseTooltip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind ViewModel.Wave.PlayPauseGlyph, Mode=OneWay}"
                                              FontSize="22" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Mood & Genre Preset Pills -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollMode="Enabled"
                                      VerticalScrollMode="Disabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Wave.Presets, Mode=OneWay}"
                                          Padding="0,2,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:WavePreset">
                                        <Button Click="PresetButton_Click"
                                                Tag="{x:Bind StationTag}"
                                                Height="38"
                                                Padding="14,0"
                                                CornerRadius="19"
                                                Background="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToPresetBackgroundBrushConverter}}"
                                                BorderBrush="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToPresetBorderBrushConverter}}"
                                                BorderThickness="1.5"
                                                helpers:CursorHelper.UseHandCursor="True"
                                                ToolTipService.ToolTip="{x:Bind Description, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- SECTION 1: Personal Playlists ("Собираем для вас" / Плейлист дня, etc.) -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowPersonalPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEC26;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PersonalPlaylistsTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PersonalPlaylists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Button Click="PersonalPlaylistCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                                Click="TogglePlaylistLikeContext_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind PlayActionText}"
                                                                Click="DirectPlayPlaylist_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE8D6;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Direct Play Button Overlay -->
                                                    <Button Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind PlayActionText}">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Description}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="2"
                                                               Height="32" />
                                                    <TextBlock Text="{x:Bind FormattedTrackCount, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 2: New Releases (Albums) -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowNewReleases, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE93C;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NewReleasesTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NewReleases, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Album">
                                    <Button Click="AlbumCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                                Click="ToggleAlbumLikeContext_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind PlayActionText}"
                                                                Click="DirectPlayAlbum_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE93C;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <Button Click="DirectPlayAlbum_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind PlayActionText}">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind ArtistNames}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Year, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 3: Editorial Playlists ("Популярные плейлисты") -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowEditorialPlaylists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE142;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EditorialPlaylistsTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollMode="Disabled">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.EditorialPlaylists, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Playlist">
                                    <Button Click="EditorialPlaylistCard_Click"
                                            Tag="{x:Bind}"
                                            Padding="0"
                                            CornerRadius="10"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <Button.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeMenuTextConverter}}"
                                                                Click="TogglePlaylistLikeContext_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="{x:Bind PlayActionText}"
                                                                Click="DirectPlayPlaylist_Click"
                                                                Tag="{x:Bind}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE768;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <Border Width="184"
                                                Padding="12"
                                                CornerRadius="10"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <Grid Width="160" Height="160">
                                                    <Border CornerRadius="8"
                                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                        <Grid>
                                                            <FontIcon Glyph="&#xE142;"
                                                                      FontSize="28"
                                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            <Image Source="{x:Bind CoverUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   Stretch="UniformToFill" />
                                                        </Grid>
                                                    </Border>

                                                    <Button Click="DirectPlayPlaylist_Click"
                                                            Tag="{x:Bind}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="8"
                                                            Width="38"
                                                            Height="38"
                                                            Padding="0"
                                                            CornerRadius="19"
                                                            Style="{ThemeResource AccentButtonStyle}"
                                                            ToolTipService.ToolTip="{x:Bind PlayActionText}">
                                                        <FontIcon Glyph="&#xE768;" FontSize="14" Margin="2,0,0,0" />
                                                    </Button>
                                                </Grid>

                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{x:Bind Title}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind OwnerName}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind FormattedTrackCount, Mode=OneTime}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <!-- SECTION 4: Top Chart ("Чарт") -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.ShowChart, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.ChartTracks, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Track">
                                <Button Click="ChartTrackRow_Click"
                                        Tag="{x:Bind}"
                                        Style="{StaticResource TrackRowButtonStyle}"
                                        helpers:TrackMenuHelper.Track="{x:Bind}"
                                        Opacity="{x:Bind TrackOpacity, Mode=OneWay}"
                                        Margin="0,1">
                                    <Border CornerRadius="8"
                                            Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}">
                                        <Grid Height="50" Padding="8,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Accent Bar -->
                                            <Rectangle Grid.Column="0"
                                                       Width="3"
                                                       Height="16"
                                                       RadiusX="1.5"
                                                       RadiusY="1.5"
                                                       Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <!-- Thumbnail with Equalizer -->
                                            <Border Grid.Column="1"
                                                    Width="38"
                                                    Height="38"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <Grid>
                                                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                                    <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          Background="#B3000000"
                                                          CornerRadius="6">
                                                        <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Title & Artist -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" MaxWidth="360" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{x:Bind FullTitle}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <Border Grid.Column="1"
                                                            Margin="6,0,0,0"
                                                            Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="4,1"
                                                            CornerRadius="3"
                                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                            <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Grid.Column="2"
                                                            Margin="6,0,0,0"
                                                            Visibility="{x:Bind IsAiTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                            Padding="4,1"
                                                            CornerRadius="3"
                                                            Background="#26EF4444"
                                                            BorderBrush="#80EF4444"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{x:Bind AiTooltip, Mode=OneWay}">
                                                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE99A;" FontSize="8" Foreground="#FFEF4444" />
                                                            <TextBlock Text="{x:Bind AiBadgeLabel, Mode=OneWay}" FontSize="8" FontWeight="Bold" Foreground="#FFEF4444" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <HyperlinkButton Click="TrackArtist_Click"
                                                                 Tag="{x:Bind}"
                                                                 Padding="0"
                                                                 Margin="0,2,0,0"
                                                                 HorizontalAlignment="Left"
                                                                 VerticalAlignment="Center"
                                                                 ToolTipService.ToolTip="{x:Bind ArtistNames}">
                                                    <TextBlock Text="{x:Bind ArtistNames}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsHitTestVisible="False" />
                                                </HyperlinkButton>
                                            </StackPanel>

                                            <!-- Album (Clickable) -->
                                            <HyperlinkButton Grid.Column="3"
                                                             Click="TrackAlbum_Click"
                                                             Tag="{x:Bind}"
                                                             Padding="0"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"
                                                             ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                                <TextBlock Text="{x:Bind AlbumTitle}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </HyperlinkButton>

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{x:Bind FormattedDuration}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. DETAIL VIEW (when Playlist or Album is clicked) -->
        <Grid x:Name="DetailViewRoot"
              Padding="24,14,24,0"
              Visibility="Collapsed"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="DetailTranslateTransform" Y="0" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Navigation Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Button Click="DetailBackButton_Click"
                        Height="36"
                        CornerRadius="18"
                        Padding="14,0"
                        helpers:CursorHelper.UseHandCursor="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.BackToExploreText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Detail Tracks List (Full Height with integrated Header!) -->
            <Grid Grid.Row="1">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingDetail, Mode=OneWay}"
                              Width="38"
                              Height="38"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Canvas.ZIndex="10" />

                <controls:ObservableListView x:Name="DetailTracksListView"
                                             Padding="0,0,0,28"
                                             ItemsSource="{x:Bind ViewModel.DetailTracks, Mode=OneWay}"
                                             IsItemClickEnabled="True"
                                             ItemClick="DetailTrack_ItemClick"
                                             SelectionMode="None">
                    <controls:ObservableListView.Header>
                        <StackPanel Spacing="10">
                            <!-- Hero Card Grid -->
                            <Grid x:Name="DetailHeroGrid" Margin="0,4,0,8" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Cover Artwork -->
                                <Border Grid.Column="0"
                                        Width="170"
                                        Height="170"
                                        CornerRadius="14"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="40"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind ViewModel.DetailCoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Metadata & Action Buttons -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="24,0,0,0"
                                            Spacing="8">
                                    <!-- Type Badge -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,2.5"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="6" Height="6" CornerRadius="3" Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DetailTypeBadge, Mode=OneWay}"
                                                       FontSize="10.5"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}"
                                               FontSize="32"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />

                                    <!-- Subtitle, Description & Meta -->
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DetailSubtitle, Mode=OneWay}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   Visibility="{x:Bind ViewModel.DetailDescription, Mode=OneWay, Converter={StaticResource NotNullToVisibilityConverter}}" />

                                        <TextBlock Text="{x:Bind ViewModel.DetailMeta, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>

                                    <!-- Actions Row + In-Playlist Filter -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- Play All Accent Button -->
                                            <Button Command="{x:Bind ViewModel.PlayDetailAllCommand}"
                                                    Style="{ThemeResource AccentButtonStyle}"
                                                    Height="40"
                                                    Padding="20,0"
                                                    CornerRadius="20"
                                                    helpers:CursorHelper.UseHandCursor="True">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                                                    <TextBlock Text="{x:Bind ViewModel.PlayAllText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Shuffle Button -->
                                            <Button Command="{x:Bind ViewModel.ShufflePlayDetailCommand}"
                                                    Height="40"
                                                    Padding="16,0"
                                                    CornerRadius="20"
                                                    helpers:CursorHelper.UseHandCursor="True"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleText, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                                    <TextBlock Text="{x:Bind ViewModel.ShuffleText, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Like / Favorite Round Button -->
                                            <Button Command="{x:Bind ViewModel.ToggleDetailLikeCommand}"
                                                    Height="40"
                                                    Width="40"
                                                    Padding="0"
                                                    CornerRadius="20"
                                                    helpers:CursorHelper.UseHandCursor="True"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeTooltipConverter}}">
                                                <FontIcon Glyph="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                          FontSize="15"
                                                          Foreground="{x:Bind ViewModel.IsDetailLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                            </Button>

                                            <!-- Pin Round Button -->
                                            <Button Command="{x:Bind ViewModel.ToggleDetailPinCommand}"
                                                    Height="40"
                                                    Width="40"
                                                    Padding="0"
                                                    CornerRadius="20"
                                                    helpers:CursorHelper.UseHandCursor="True"
                                                    ToolTipService.ToolTip="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinTooltipConverter}}">
                                                <FontIcon Glyph="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinGlyphConverter}}"
                                                          FontSize="14"
                                                          Foreground="{x:Bind ViewModel.IsDetailPinned, Mode=OneWay, Converter={StaticResource BoolToPinForegroundBrushConverter}}" />
                                            </Button>
                                        </StackPanel>

                                        <!-- In-Playlist Search / Filter -->
                                        <AutoSuggestBox Grid.Column="1"
                                                        Width="220"
                                                        Height="38"
                                                        CornerRadius="19"
                                                        HorizontalAlignment="Right"
                                                        Margin="16,0,0,0"
                                                        VerticalAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        Visibility="{x:Bind ViewModel.HasTracksToFilter, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        PlaceholderText="{x:Bind ViewModel.FilterPlaceholder, Mode=OneWay}"
                                                        QueryIcon="Find"
                                                        Text="{x:Bind ViewModel.DetailSearchFilter, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Column Header Strip -->
                            <Grid Height="30" Margin="4,8,4,0" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="38" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ColumnHeaderTitle, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.ColumnHeaderAlbum, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <FontIcon Grid.Column="4" Glyph="&#xE916;" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,6,0" />
                            </Grid>
                        </StackPanel>
                    </controls:ObservableListView.Header>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource TrackRowListViewItemStyle}">
                            <Setter Property="MinHeight" Value="48" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel>
                                <ItemsStackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="8" />
                                        <AddDeleteThemeTransition />
                                    </TransitionCollection>
                                </ItemsStackPanel.ChildrenTransitions>
                            </ItemsStackPanel>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Track">
                            <Border CornerRadius="8"
                                    helpers:TrackMenuHelper.Track="{x:Bind}"
                                    Opacity="{x:Bind TrackOpacity, Mode=OneWay}"
                                    Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                    Margin="0">
                                <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Accent Indicator -->
                                    <Rectangle Grid.Column="0"
                                               Width="3"
                                               Height="18"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Margin="0,0,6,0"
                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Thumbnail with Animated Equalizer -->
                                    <Border Grid.Column="1"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="6"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8D6;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                            <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Background="#A6000000"
                                                  CornerRadius="6">
                                                <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Title & Artist -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="360" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind FullTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />
                                            <Border Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="4,1"
                                                    CornerRadius="3"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                    <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Margin="6,0,0,0"
                                                    Visibility="{x:Bind IsAiTrack, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Padding="4,1"
                                                    CornerRadius="3"
                                                    Background="#26EF4444"
                                                    BorderBrush="#80EF4444"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{x:Bind AiTooltip, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE99A;" FontSize="8" Foreground="#FFEF4444" />
                                                    <TextBlock Text="{x:Bind AiBadgeLabel, Mode=OneWay}" FontSize="8" FontWeight="Bold" Foreground="#FFEF4444" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <HyperlinkButton Click="TrackArtist_Click"
                                                         Tag="{x:Bind}"
                                                         Padding="0"
                                                         Margin="0,2,0,0"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         ToolTipService.ToolTip="{x:Bind ArtistNames}">
                                            <TextBlock Text="{x:Bind ArtistNames}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsHitTestVisible="False" />
                                        </HyperlinkButton>
                                    </StackPanel>

                                    <!-- Album (Clickable) -->
                                    <HyperlinkButton Grid.Column="3"
                                                     Click="TrackAlbum_Click"
                                                     Tag="{x:Bind}"
                                                     Padding="0"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                        <TextBlock Text="{x:Bind AlbumTitle}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </HyperlinkButton>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind FormattedDuration}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />

                                    <!-- Like Button -->
                                    <Button Grid.Column="5"
                                            Click="DetailLikeButton_Click"
                                            Tag="{x:Bind}"
                                            Width="34"
                                            Height="34"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="17"
                                            Background="Transparent"
                                            BorderBrush="Transparent">
                                        <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                                  FontSize="15"
                                                  Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </controls:ObservableListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
