<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="YMusic.WinUI.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Title="WinYandex"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <!-- Title Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Navigation & Pages -->
            <RowDefinition Height="*" />
            <!-- Fixed Bottom Player Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <TitleBar x:Name="AppTitleBar"
                  Title="WinYandex">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- NavigationView -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        OpenPaneLength="210"
                        CompactPaneLength="48"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        ItemInvoked="NavView_ItemInvoked"
                        SelectionChanged="NavView_SelectionChanged">
            
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="NavAutoSuggestBox"
                                QueryIcon="Find"
                                PlaceholderText="{x:Bind ViewModel.SearchPlaceholderText, Mode=OneWay}"
                                QuerySubmitted="NavAutoSuggestBox_QuerySubmitted" />
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavItemExplore"
                                    Content="{x:Bind ViewModel.NavExploreText, Mode=OneWay}"
                                    Tag="Explore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemSearch"
                                    Content="{x:Bind ViewModel.NavSearchText, Mode=OneWay}"
                                    Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemWave"
                                    Content="{x:Bind ViewModel.NavWaveText, Mode=OneWay}"
                                    Tag="Wave">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemLikes"
                                    Content="{x:Bind ViewModel.NavLikesText, Mode=OneWay}"
                                    Tag="Likes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB52;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavItemPlaylists"
                                    Content="{x:Bind ViewModel.NavPlaylistsText, Mode=OneWay}"
                                    Tag="Playlists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE142;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="NavItemAccount"
                                    Content="{x:Bind ViewModel.AccountNavItemTitle, Mode=OneWay}"
                                    Tag="Account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Update Notification Banner -->
                <InfoBar x:Name="UpdateInfoBar"
                         IsOpen="{x:Bind ViewModel.IsUpdateBannerOpen, Mode=OneWay}"
                         Severity="Informational"
                         Title="{x:Bind ViewModel.UpdateBannerTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.UpdateBannerMessage, Mode=OneWay}"
                         IsClosable="True"
                         CloseButtonClick="UpdateInfoBar_CloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button Content="{x:Bind ViewModel.UpdateBannerButtonText, Mode=OneWay}"
                                Command="{x:Bind ViewModel.OpenUpdatesCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                CornerRadius="4" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>

        <!-- Fixed Bottom Player Bar (Hidden when Now Playing Drawer is open) -->
        <controls:PlayerBarControl Grid.Row="2"
                                   x:Name="BottomPlayerBar" />

        <!-- Now Playing & Karaoke Lyrics Drawer Overlay (Full Window Immersion, spans all rows 0..2) -->
        <controls:NowPlayingDrawerControl Grid.Row="0"
                                          Grid.RowSpan="3"
                                          x:Name="NowPlayingDrawer" />
    </Grid>
</Window>
