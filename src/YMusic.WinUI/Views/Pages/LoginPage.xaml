<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <!-- 1. Standard Login View -->
        <Border x:Name="LoginCard"
                Width="460"
                Padding="36"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            
            <StackPanel Spacing="16">
                <!-- Brand Icon -->
                <Border Width="64"
                        Height="64"
                        CornerRadius="32"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xEC4F;"
                              FontSize="28"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
                
                <TextBlock Text="Welcome to Yandex Music"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Sign in with your Yandex account to access your music library, favorite tracks, and playlists."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" />

                <!-- Error Notification -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Title="Authentication Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <!-- Convenient One-Click Web OAuth Button -->
                <Button x:Name="SignInWithYandexButton"
                        Click="SignInWithYandexButton_Click"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Height="44"
                        CornerRadius="8"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;" FontSize="18" />
                        <TextBlock Text="Sign In with Yandex ID"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <!-- Loading spinner -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="28"
                              Height="28"
                              HorizontalAlignment="Center" />

                <!-- Manual Token Expander for Debugging/Power Users -->
                <Expander Header="Or enter token manually"
                          HorizontalAlignment="Stretch"
                          Margin="0,12,0,0">
                    <StackPanel Spacing="12" Padding="4">
                        <TextBlock Text="Paste your Yandex OAuth token below if you already have one:"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <PasswordBox Password="{x:Bind ViewModel.TokenInput, Mode=TwoWay}"
                                     PlaceholderText="y0_AgAAAA..." />

                        <Button Command="{x:Bind ViewModel.LoginWithTokenCommand}"
                                Content="Submit Token"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <!-- 2. Embedded WebView2 OAuth Overlay -->
        <Grid x:Name="OAuthOverlay"
              Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              VerticalAlignment="Stretch"
              HorizontalAlignment="Stretch">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar with Back/Cancel button -->
            <Grid Grid.Row="0"
                  Padding="16,12"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelOAuthButton"
                        Click="CancelOAuthButton_Click"
                        Height="36">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock Text="Cancel" />
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1"
                           Text="Yandex ID Authorization"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,80,0" />
            </Grid>

            <!-- WebView2 Browser -->
            <Grid Grid.Row="1">
                <WebView2 x:Name="OAuthWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          NavigationStarting="OAuthWebView_NavigationStarting"
                          NavigationCompleted="OAuthWebView_NavigationCompleted" />

                <ProgressRing x:Name="WebViewProgressRing"
                              IsActive="True"
                              Width="44"
                              Height="44"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
