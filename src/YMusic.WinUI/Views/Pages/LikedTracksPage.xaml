<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.LikedTracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:controls="using:YMusic.WinUI.Views.Controls"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="20,18,20,16">
        <Grid.RowDefinitions>
            <!-- Header & Controls -->
            <RowDefinition Height="Auto" />
            <!-- Tracks List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Info -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Liked Tracks"
                           FontSize="28"
                           FontWeight="Bold" />
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.TotalTrackCount, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="tracks"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                    <Button Command="{x:Bind ViewModel.PlayAllCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Play All" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ShufflePlayAllCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.LoadTracksCommand}"
                            Height="36"
                            ToolTipService.ToolTip="Refresh tracks">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Search Filter Box -->
            <AutoSuggestBox Grid.Column="1"
                            Width="260"
                            Height="36"
                            VerticalAlignment="Bottom"
                            PlaceholderText="Filter tracks or artists..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay}" />
        </Grid>

        <!-- 2. Track List with UI Virtualization -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <!-- Error message if any -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Error Loading Tracks"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     VerticalAlignment="Top" />

            <!-- Virtualized Track List -->
            <ListView ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="TrackListView_ItemClick"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="MinHeight" Value="48" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Border CornerRadius="8"
                                Background="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackHighlightBrushConverter}}"
                                Margin="0">
                            <Grid Height="48" Padding="6,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <!-- Accent Indicator Bar -->
                                <Rectangle Grid.Column="0"
                                           Width="3"
                                           Height="18"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Margin="0,0,6,0"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Thumbnail -->
                                <Border Grid.Column="1"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="4"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8D6;"
                                                  FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />

                                        <!-- Equalizer Playing Overlay -->
                                        <Grid Visibility="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                              Background="#A6000000"
                                              CornerRadius="4">
                                            <controls:MiniEqualizerControl IsPlaying="{x:Bind IsPlaying, Mode=OneWay}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Title & Artist -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MaxWidth="360" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind FullTitle}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{x:Bind IsCurrent, Mode=OneWay, Converter={StaticResource BoolToTrackTitleBrushConverter}}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <Border Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Visibility="{x:Bind IsReplaced, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Padding="4,1"
                                                CornerRadius="3"
                                                Background="#2EFD6C"
                                                BorderBrush="#40FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="Трек подменен FckCensor (Uncensored)">
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE70F;" FontSize="8" Foreground="#000000" />
                                                <TextBlock Text="FCK" FontSize="9" FontWeight="Bold" Foreground="#000000" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ArtistNames}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Album (Clickable) -->
                                <HyperlinkButton Grid.Column="3"
                                                 Click="TrackAlbum_Click"
                                                 Tag="{x:Bind}"
                                                 Padding="0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 ToolTipService.ToolTip="{x:Bind AlbumTitle}">
                                    <TextBlock Text="{x:Bind AlbumTitle}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </HyperlinkButton>

                                <!-- Duration -->
                                <TextBlock Grid.Column="4"
                                           Text="{x:Bind FormattedDuration}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Like Button -->
                                <Button Grid.Column="5"
                                        Click="UnlikeButton_Click"
                                        Tag="{x:Bind}"
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        CornerRadius="18"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        ToolTipService.ToolTip="Liked (Click to unlike)">
                                    <FontIcon Glyph="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeGlyphConverter}}"
                                              FontSize="16"
                                              Foreground="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
