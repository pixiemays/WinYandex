<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="YMusic.WinUI.Views.Pages.LikedTracksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,16">
        <Grid.RowDefinitions>
            <!-- Header & Controls -->
            <RowDefinition Height="Auto" />
            <!-- Tracks List -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title & Info -->
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Liked Tracks"
                           FontSize="28"
                           FontWeight="Bold" />
                
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.TotalTrackCount, Mode=OneWay}"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="tracks"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                    <Button Command="{x:Bind ViewModel.PlayAllCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Play All" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ShufflePlayAllCommand}"
                            Height="36">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                            <TextBlock Text="Shuffle" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.LoadTracksCommand}"
                            Height="36"
                            ToolTipService.ToolTip="Refresh tracks">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Search Filter Box -->
            <AutoSuggestBox Grid.Column="1"
                            Width="260"
                            Height="36"
                            VerticalAlignment="Bottom"
                            PlaceholderText="Filter tracks or artists..."
                            QueryIcon="Find"
                            Text="{x:Bind ViewModel.SearchFilter, Mode=TwoWay}" />
        </Grid>

        <!-- 2. Track List with UI Virtualization -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />

            <!-- Error message if any -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Error Loading Tracks"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     VerticalAlignment="Top" />

            <!-- Virtualized Track List -->
            <ListView ItemsSource="{x:Bind ViewModel.FilteredTracks, Mode=OneWay}"
                      IsItemClickEnabled="True"
                      ItemClick="TrackListView_ItemClick"
                      SelectionMode="None">
                
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid Height="52" Padding="8,4" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D6;"
                                              FontSize="16"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    <Image Source="{x:Bind ThumbnailUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FullTitle}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ArtistNames}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Album -->
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind AlbumTitle}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />

                            <!-- Duration -->
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind FormattedDuration}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />

                            <!-- Like Button (в самом право, после времени трека) -->
                            <Button Grid.Column="4"
                                    Click="UnlikeButton_Click"
                                    Tag="{x:Bind}"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    CornerRadius="18"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    ToolTipService.ToolTip="Liked (Click to unlike)">
                                <FontIcon Glyph="&#xEB52;"
                                          FontSize="16"
                                          Foreground="#FF4081" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
