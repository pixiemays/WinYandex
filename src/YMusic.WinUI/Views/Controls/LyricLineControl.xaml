<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="YMusic.WinUI.Views.Controls.LyricLineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:helpers="using:YMusic.WinUI.Helpers"
    DataContextChanged="UserControl_DataContextChanged"
    Loaded="UserControl_Loaded"
    Unloaded="UserControl_Unloaded"
    PointerEntered="UserControl_PointerEntered"
    PointerExited="UserControl_PointerExited"
    helpers:CursorHelper.UseHandCursor="True"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Margin="0,3">
        <!-- ContentContainer holds BOTH ActivePillBorder and Text Content, ensuring they never desynchronize -->
        <Border x:Name="ContentContainer"
                HorizontalAlignment="Stretch"
                RenderTransformOrigin="0.0, 0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="LineScale" ScaleX="0.96" ScaleY="0.96" />
                    <TranslateTransform x:Name="LineTranslate" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <!-- Active Highlight Frosted Pill Background (Shares exact container bounds) -->
                <Border x:Name="ActivePillBorder"
                        Background="#22FFFFFF"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        CornerRadius="16"
                        Opacity="0"
                        IsHitTestVisible="False" />

                <!-- Text & Timestamp Grid (Cleanly padded inside the pill) -->
                <Grid Padding="20,12,24,12" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Karaoke Lyric Text Line -->
                    <TextBlock x:Name="LineTextBlock"
                               Grid.Column="0"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Opacity="0.45"
                               TextWrapping="Wrap"
                               LineHeight="40"
                               VerticalAlignment="Center" />

                    <!-- Subtle Timestamp (Cleanly aligned inside the pill on the right) -->
                    <TextBlock x:Name="TimestampTextBlock"
                               Grid.Column="1"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#85FFFFFF"
                               Opacity="0.4"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
