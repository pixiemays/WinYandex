<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="YMusic.WinUI.Views.Controls.PlayerBarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:YMusic.WinUI.Models"
    xmlns:vm="using:YMusic.WinUI.ViewModels"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">

    <Grid Height="88"
          Padding="16,4,16,6"
          BorderThickness="0,1,0,0"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
        
        <Grid.ColumnDefinitions>
            <!-- Left: Current Track Details -->
            <ColumnDefinition Width="320" />
            <!-- Center: Controls & Seek Bar -->
            <ColumnDefinition Width="*" />
            <!-- Right: Volume & Extra -->
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!-- 1. Track Info (Left) -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>

            <!-- Album Art (Clickable to open album) -->
            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.OpenCurrentAlbumCommand}"
                    Padding="0"
                    Width="52"
                    Height="52"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="View album">
                <Border Width="52"
                        Height="52"
                        CornerRadius="6"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;"
                                  FontSize="24"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        <Image Source="{x:Bind ViewModel.CoverUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Border>
            </Button>

            <!-- Title & Artist (Click title to open album) -->
            <Grid Grid.Column="1"
                  Margin="12,0,8,0"
                  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <HyperlinkButton Grid.Row="0"
                                 Command="{x:Bind ViewModel.OpenCurrentAlbumCommand}"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 ToolTipService.ToolTip="View album">
                    <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1" />
                </HyperlinkButton>
                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.ArtistNames, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"
                           Margin="0,2,0,0" />
            </Grid>

            <!-- Like Button in Track Info -->
            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.ToggleLikeCommand}"
                    Width="36"
                    Height="36"
                    Padding="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="18"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="{x:Bind ViewModel.LikeTooltip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind ViewModel.LikeGlyph, Mode=OneWay}"
                          FontSize="18"
                          Foreground="{x:Bind ViewModel.IsCurrentTrackLiked, Mode=OneWay, Converter={StaticResource BoolToLikeBrushConverter}}" />
            </Button>
        </Grid>

        <!-- 2. Center: Playback Controls & Progress Bar -->
        <StackPanel Grid.Column="1"
                    MaxWidth="600"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
            
            <!-- Controls buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                
                <!-- Shuffle -->
                <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;"
                              FontSize="16"
                              Foreground="{x:Bind ViewModel.IsShuffle, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}" />
                </Button>

                <!-- Previous -->
                <Button Command="{x:Bind ViewModel.PreviousCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Previous">
                    <FontIcon Glyph="&#xE892;" FontSize="16" />
                </Button>

                <!-- Play / Pause -->
                <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                        Width="44"
                        Height="44"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="22"
                        Style="{ThemeResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Play / Pause">
                    <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                              FontSize="18"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Button>

                <!-- Next -->
                <Button Command="{x:Bind ViewModel.NextCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Next">
                    <FontIcon Glyph="&#xE893;" FontSize="16" />
                </Button>

                <!-- Repeat -->
                <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                        Width="36"
                        Height="36"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        CornerRadius="18"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        ToolTipService.ToolTip="Repeat">
                    <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}"
                              FontSize="16"
                              Foreground="{x:Bind ViewModel.RepeatMode, Mode=OneWay, Converter={StaticResource RepeatToAccentBrushConverter}}" />
                </Button>
            </StackPanel>

            <!-- Progress bar slider -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{x:Bind ViewModel.FormattedPosition, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />

                <Slider x:Name="SeekSlider"
                        Grid.Column="1"
                        Margin="8,0"
                        Minimum="0"
                        Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                        Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                        ThumbToolTipValueConverter="{StaticResource SecondsToTimeConverter}"
                        VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="{x:Bind ViewModel.FormattedDuration, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
            </Grid>
        </StackPanel>

        <!-- 3. Right: Volume & Quality Controls -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="8">
            
            <!-- Audio Quality Pill & Selector Flyout -->
            <Button Height="28"
                    MinWidth="52"
                    Padding="10,2"
                    CornerRadius="6"
                    HorizontalContentAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.QualityTooltip, Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.QualityBadge, Mode=OneWay}"
                           FontSize="11"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <Button.Flyout>
                    <MenuFlyout Placement="Top">
                        <MenuFlyoutItem Text="AAC (High Quality, 192–256 kbps)"
                                        Command="{x:Bind ViewModel.SetAudioQualityPreferenceCommand}"
                                        CommandParameter="AacPreferred" />
                        <MenuFlyoutItem Text="MP3 (High Quality, 320 kbps)"
                                        Command="{x:Bind ViewModel.SetAudioQualityPreferenceCommand}"
                                        CommandParameter="Mp3Preferred" />
                        <MenuFlyoutItem Text="Best Available Bitrate"
                                        Command="{x:Bind ViewModel.SetAudioQualityPreferenceCommand}"
                                        CommandParameter="HighestBitrate" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Equalizer Button & Flyout -->
            <Button Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="Audio Equalizer">
                <FontIcon Glyph="&#xE9E9;"
                          FontSize="16"
                          Foreground="{x:Bind ViewModel.IsEqualizerEnabled, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}" />
                <Button.Flyout>
                    <Flyout Placement="Top">
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="MinWidth" Value="540" />
                                <Setter Property="MaxWidth" Value="560" />
                                <Setter Property="Padding" Value="14" />
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="520" Spacing="14">
                            <!-- Top Bar: Title on Left, Toggle & Reset on Right -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="Equalizer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsEqualizerEnabled, Mode=TwoWay}"
                                                  OnContent="On"
                                                  OffContent="Off"
                                                  Margin="0" />

                                    <Button Command="{x:Bind ViewModel.ResetEqualizerCommand}"
                                            Content="Reset"
                                            Height="32"
                                            Padding="14,0"
                                            ToolTipService.ToolTip="Reset all bands to 0 dB" />
                                </StackPanel>
                            </Grid>

                            <!-- Preset Selector Row -->
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Preset:"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.EqualizerPresetNames}"
                                          SelectedItem="{x:Bind ViewModel.CurrentEqualizerPresetName, Mode=TwoWay}"
                                          Width="160"
                                          Height="32"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 10 Frequency Sliders -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.EqualizerBands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:EqualizerBand">
                                        <StackPanel HorizontalAlignment="Center" Spacing="4" Width="46">
                                            <TextBlock Text="{x:Bind FormattedGain, Mode=OneWay}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                            <Slider Orientation="Vertical"
                                                    Height="120"
                                                    Minimum="-12"
                                                    Maximum="12"
                                                    StepFrequency="0.5"
                                                    Value="{x:Bind Gain, Mode=TwoWay}"
                                                    HorizontalAlignment="Center" />
                                            <TextBlock Text="{x:Bind Label}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Command="{x:Bind ViewModel.ToggleMuteCommand}"
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    ToolTipService.ToolTip="Mute / Unmute">
                <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" FontSize="16" />
            </Button>

            <Slider Width="120"
                    Minimum="0"
                    Maximum="100"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                    VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
